{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".gitignore",
      ".agents/**",
      "firebase-debug.log",
      "node_modules/**",
      "scratch/**",
      "*.zip",
      "*.backup",
      "*.bak",
      "*.safe_point",
      "*backup*.html",
      "server.js",
      "test.js",
      "COMANDI_*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
