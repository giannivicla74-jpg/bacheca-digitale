                            <span class="font-medium">${escapeHtml(fault.mechanicNotes)}</span>
                        </div>
                    </div>
                    `
                    : '';

                let workerCardTheme = "gc-fault-card-media";
                if (fault.status === 'Risolto') {
                    workerCardTheme = "gc-fault-card-risolto";
                } else if (fault.status === 'In Riparazione') {
                    workerCardTheme = "gc-fault-card-repair";
                } else if (fault.severity === 'ALTA') {
                    workerCardTheme = "gc-fault-card-alta";
