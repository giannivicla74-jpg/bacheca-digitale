            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Invio in corso...';
            }

            try {
                const vehicleId = document.getElementById('fault-vehicle-select').value;
                const cantiere = document.getElementById('fault-cantiere-input').value.trim();
                const severityEl = document.querySelector('input[name="fault-severity"]:checked');
                const severity = severityEl ? severityEl.value : 'ALTA';
                const description = document.getElementById('fault-description-input').value.trim();

                const vehicleList = Array.isArray(window.vehicles) ? window.vehicles : [];
                const selectedVehicle = vehicleList.find(v => v.id === vehicleId) || { id: vehicleId, name: 'Mezzo Aziendale', plate: '-' };

                // Identifica chi sta segnalando
                let reporterName = "Operatore Cantiere";
                let reporterId = "OPERAIO";
                if (window.currentRole === 'admin') {
                    reporterName = "Responsabile / Capocantiere";
                    reporterId = "ADMIN";
                } else if (window.selectedWorkerId && Array.isArray(window.workers)) {
                    const w = window.workers.find(wk => wk.id === window.selectedWorkerId);
                    if (w) {
                        reporterName = `${w.name} ${w.surname}`.trim();
                        reporterId = w.id;
                    }
                }

                const faultId = "FLT_" + Date.now().toString(36).toUpperCase();
                const newFault = {
                    id: faultId,
                    vehicleId: selectedVehicle.id,
                    vehicleName: selectedVehicle.name,
                    plate: selectedVehicle.plate || '-',
                    category: selectedVehicle.type || 'Mezzo Aziendale',
                    reportedBy: reporterId,
                    workerName: reporterName,
                    cantiere: cantiere,
                    severity: severity, // 'ALTA', 'MEDIA', 'BASSA'
                    description: description,
                    photos: [...window.currentFaultPhotos],
                    status: 'Aperta',
                    mechanicNotes: '',
                    dateReported: new Date().toISOString().split('T')[0],
                    timeReported: new Date().toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' }),
                    createdAt: new Date().toISOString()
                };

                // Aggiorna stato del mezzo se urgenza ALTA (Fermo Mezzo)
                if (severity === 'ALTA' && selectedVehicle.id) {
                    selectedVehicle.status = 'Fermo Mezzo';
                    if (window.viclaCloudDB && window.viclaCloudDB.updateVehicle) {
                        window.viclaCloudDB.updateVehicle(selectedVehicle.id, { status: 'Fermo Mezzo' }).catch(console.warn);
                    }
                }

                // Salva in array locale
                if (!Array.isArray(window.vehicleFaults)) window.vehicleFaults = [];
                window.vehicleFaults.unshift(newFault);
                localStorage.setItem('vicla_vehicle_faults', JSON.stringify(window.vehicleFaults));

                // Sincronizza su Firestore Cloud
                if (window.viclaCloudDB && window.viclaCloudDB.addVehicleFault) {
                    await window.viclaCloudDB.addVehicleFault(newFault);
                }

                // Genera Notifica Push & Alert per Admin e Responsabili
                const sevIcon = severity === 'ALTA' ? '🚨' : (severity === 'MEDIA' ? '⚠️' : '🔧');
                const notifTitle = `${sevIcon} Guasto: ${selectedVehicle.name} (${selectedVehicle.plate})`;
                const notifMsg = `${reporterName} (${cantiere}): [${severity}] ${description}`;

                if (typeof window.addNotification === 'function') {
                    window.addNotification({
                        workerId: "ADMIN",
                        title: notifTitle,
                        message: notifMsg,
                        type: "alert",
                        targetTab: "vehicles"
                    });
                }
                if (window.viclaCloudDB && window.viclaCloudDB.addNotificationCloud) {
                    window.viclaCloudDB.addNotificationCloud({
                        workerId: "ADMIN",
                        title: notifTitle,
                        message: notifMsg,
                        type: "alert",
                        targetTab: "vehicles"
                    }).catch(console.warn);
                }
                if (typeof window.sendPushToManagers === 'function') {
                    window.sendPushToManagers({
                        title: notifTitle,
                        body: notifMsg,
                        targetTab: "vehicles"
                    });
                }

                showToast("🚜 Segnalazione guasto registrata ed inviata ai Responsabili!", "success");
                closeVehicleFaultModal();

                // Aggiorna interfacce
                renderVehicleFleetTab();
                renderWorkerVehicleFaults();

            } catch (err) {
                console.error("Errore invio guasto:", err);
                showToast("Errore durante l'invio della segnalazione.", "error");
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Invia Segnalazione';
                }
            }
        }
        window.submitVehicleFaultReport = submitVehicleFaultReport;

        // Visualizzatore Foto Full-Screen (Lightbox)
        function openPhotoViewer(imgSrc, caption = "Dettaglio Guasto", vehicleName = "Mezzo Vi.Cla.") {
            const modal = document.getElementById('modal-photo-viewer');
            const img = document.getElementById('photo-viewer-img');
            const cap = document.getElementById('photo-viewer-caption');
            const tit = document.getElementById('photo-viewer-title');
            const dl = document.getElementById('photo-viewer-download');

            if (!modal || !img) return;
            img.src = imgSrc;
            if (cap) cap.textContent = caption;
            if (tit) tit.textContent = `Foto: ${vehicleName}`;
            if (dl) dl.href = imgSrc;

            modal.classList.remove('hidden');
        }
        window.openPhotoViewer = openPhotoViewer;

        function closePhotoViewer() {
            const modal = document.getElementById('modal-photo-viewer');
            if (modal) modal.classList.add('hidden');
        }
        window.closePhotoViewer = closePhotoViewer;

        // Filtro per stato guasti nell'Admin (Soluzione 2 + Soluzione 1 Integrata)
        function setFaultFilter(status) {
            window.faultFilterStatus = status;
            ['all', 'active', 'In Riparazione', 'Risolto', 'archived'].forEach(st => {
                const btn = document.getElementById(`fault-filter-btn-${st}`);
                if (!btn) return;
                const isSelected = (st === status) || (st === 'active' && (status === 'Aperta' || status === 'ALTA'));
                if (isSelected) {
                    btn.className = "px-3 py-1.5 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs transition-all font-bold flex items-center gap-1.5 cursor-pointer";
                } else {
                    btn.className = "px-3 py-1.5 rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-all font-bold flex items-center gap-1.5 cursor-pointer";
                }
            });
            renderVehicleFleetTab();
        }
        window.setFaultFilter = setFaultFilter;

        // Filtro rapido cliccando sui 5 Moduli Visivi KPI Contatori GC CodeLab
        function filterVehicleKPI(filterType) {
            window.fleetTableFilter = filterType;
            if (filterType === 'all') {
                setFaultFilter('all');
            } else if (filterType === 'Operativo') {
                setFaultFilter('all');
            } else if (filterType === 'In Riparazione') {
                setFaultFilter('In Riparazione');
            } else if (filterType === 'Fermo Mezzo') {
                setFaultFilter('active');
            } else if (filterType === 'Aperta') {
                setFaultFilter('active');
            }
            renderVehicleFleetTab();
        }
        window.filterVehicleKPI = filterVehicleKPI;

        // Render Pannello Parco Mezzi & Guasti per Admin / Responsabile Mezzi
        function renderVehicleFleetTab() {
            const faults = Array.isArray(window.vehicleFaults) ? window.vehicleFaults : [];
            const vehicles = Array.isArray(window.vehicles) ? window.vehicles : [];

            // 1. KPI COUNTERS (5 Moduli Visivi GC CodeLab)
            const elTotalVehicles = document.getElementById('kpi-total-vehicles');
            const elActiveVehicles = document.getElementById('kpi-active-vehicles');
            const elRepairVehicles = document.getElementById('kpi-maintenance-vehicles');
            const elBrokenVehicles = document.getElementById('kpi-broken-vehicles');
            const elOpenFaults = document.getElementById('kpi-open-faults');
            const badgeVehicles = document.getElementById('vehicles-count-badge');
            const badgeAdminFaults = document.getElementById('admin-faults-count-badge');

            const activeVehiclesCount = vehicles.filter(v => v.status === 'Operativo').length;
            const repairVehiclesCount = vehicles.filter(v => v.status === 'In Riparazione').length + faults.filter(f => f.status === 'In Riparazione').length;
            const brokenVehiclesCount = vehicles.filter(v => v.status === 'Fermo Mezzo').length;
            const openFaultsCount = faults.filter(f => f.status !== 'Risolto').length;

            if (elTotalVehicles) elTotalVehicles.textContent = vehicles.length;
            if (elActiveVehicles) elActiveVehicles.textContent = activeVehiclesCount;
            if (elRepairVehicles) elRepairVehicles.textContent = repairVehiclesCount;
            if (elBrokenVehicles) elBrokenVehicles.textContent = brokenVehiclesCount;
            if (elOpenFaults) elOpenFaults.textContent = openFaultsCount;
            if (badgeVehicles) badgeVehicles.textContent = `${vehicles.length} Mezzi`;

            if (badgeAdminFaults) {
                if (openFaultsCount > 0) {
                    badgeAdminFaults.textContent = openFaultsCount;
                    badgeAdminFaults.classList.remove('hidden');
                } else {
                    badgeAdminFaults.classList.add('hidden');
                }
            }

            // 2. LISTA SEGNALAZIONI GUASTI (SUDDIVISIONE SMART PRIORITY: ATTIVI IN CIMA vs RISOLTI)
            const listContainer = document.getElementById('admin-faults-list-container');
            if (listContainer) {
                // Funzione Helper interna per generare la singola Card del guasto con layout d'eccellenza
                function renderSingleFaultCard(fault) {
                    let headerBadgesHtml = '';
                    if (fault.archived) {
                        // Guasto archiviato
                        headerBadgesHtml = `
                            <span class="px-2.5 py-1 bg-amber-500/15 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-500/30 font-bold rounded-lg text-xs flex items-center gap-1.5">
                                <i class="fa-solid fa-box-archive text-amber-500"></i> ARCHIVIATO
                            </span>
                            <span class="px-3 py-1 bg-emerald-500 text-white font-black rounded-lg text-xs shadow-xs flex items-center gap-1">
                                <i class="fa-solid fa-circle-check"></i> RISOLTO
                            </span>
                        `;
                    } else if (fault.status === 'Risolto') {
                        // Guasto risolto: mezzo ripristinato ed operativo, nessuna allerta fermo mezzo
                        headerBadgesHtml = `
                            <span class="px-2.5 py-1 bg-emerald-500/15 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 font-bold rounded-lg text-xs flex items-center gap-1.5">
                                <i class="fa-solid fa-truck-fast text-emerald-500"></i> MEZZO OPERATIVO
                            </span>
                            <span class="px-3 py-1 bg-emerald-500 text-white font-black rounded-lg text-xs shadow-xs flex items-center gap-1">
                                <i class="fa-solid fa-circle-check"></i> RISOLTO
                            </span>
                        `;
                    } else if (fault.status === 'In Riparazione') {
                        const sevBadge = fault.severity === 'ALTA'
                            ? '<span class="px-2.5 py-1 bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 font-extrabold rounded-lg text-xs flex items-center gap-1"><i class="fa-solid fa-circle-exclamation"></i> FERMO MEZZO (ALTA)</span>'
                            : (fault.severity === 'MEDIA'
                                ? '<span class="px-2.5 py-1 bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 font-extrabold rounded-lg text-xs flex items-center gap-1"><i class="fa-solid fa-triangle-exclamation"></i> MARCIANTE (MEDIA)</span>'
                                : '<span class="px-2.5 py-1 bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-extrabold rounded-lg text-xs flex items-center gap-1"><i class="fa-solid fa-wrench"></i> ORDINARIA (BASSA)</span>');
                        headerBadgesHtml = `
                            ${sevBadge}
                            <span class="px-3 py-1 bg-amber-500 text-white font-extrabold rounded-lg text-xs shadow-xs flex items-center gap-1">
                                <i class="fa-solid fa-wrench"></i> IN RIPARAZIONE
                            </span>
                        `;
                    } else {
                        // Aperta
                        const sevBadge = fault.severity === 'ALTA'
                            ? '<span class="px-2.5 py-1 bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 font-extrabold rounded-lg text-xs flex items-center gap-1"><i class="fa-solid fa-circle-exclamation"></i> FERMO MEZZO (ALTA)</span>'
                            : (fault.severity === 'MEDIA'
                                ? '<span class="px-2.5 py-1 bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 font-extrabold rounded-lg text-xs flex items-center gap-1"><i class="fa-solid fa-triangle-exclamation"></i> MARCIANTE (MEDIA)</span>'
                                : '<span class="px-2.5 py-1 bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-extrabold rounded-lg text-xs flex items-center gap-1"><i class="fa-solid fa-wrench"></i> ORDINARIA (BASSA)</span>');
                        headerBadgesHtml = `
                            ${sevBadge}
                            <span class="px-3 py-1 bg-rose-500 text-white font-extrabold rounded-lg text-xs shadow-xs flex items-center gap-1">
                                <i class="fa-solid fa-circle-dot"></i> APERTA
                            </span>
                        `;
                    }

                    const photosHtml = (Array.isArray(fault.photos) && fault.photos.length > 0)
                        ? `
                        <div class="mt-3">
                            <span class="text-[10px] font-bold text-slate-400 dark:text-slate-400 uppercase tracking-wider block mb-1.5">Foto Allegate (${fault.photos.length}) - Clicca per ingrandire:</span>
                            <div class="flex flex-wrap gap-2">
                                ${fault.photos.map((p, pIdx) => `
                                    <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden border border-slate-300 dark:border-slate-700 cursor-pointer hover:opacity-90 hover:scale-105 transition-all shadow-sm group"
                                        onclick="openPhotoViewer('${p}', '${fault.vehicleName} - ${fault.plate} | ${fault.cantiere || ''}', '${fault.vehicleName}')">
                                        <img src="${p}" class="w-full h-full object-cover">
                                        <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 flex items-center justify-center text-white transition-opacity">
                                            <i class="fa-solid fa-magnifying-glass-plus text-xs"></i>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                        `
                        : '<p class="text-[11px] text-slate-400 italic mt-2">Nessuna foto allegata.</p>';

                    let cardThemeClass = "gc-fault-card-media";
                    if (fault.archived) {
                        cardThemeClass = "gc-fault-card-risolto border-amber-500/40 bg-amber-500/5";
                    } else if (fault.status === 'Risolto') {
                        cardThemeClass = "gc-fault-card-risolto";
                    } else if (fault.status === 'In Riparazione') {
                        cardThemeClass = "gc-fault-card-repair";
                    } else if (fault.severity === 'ALTA') {
                        cardThemeClass = "gc-fault-card-alta";
                    } else {
                        cardThemeClass = "gc-fault-card-media";
                    }

                    // Formattazione data italiana elegante
                    let formattedDateStr = fault.dateReported || '';
                    if (formattedDateStr && /^\d{4}-\d{2}-\d{2}$/.test(formattedDateStr)) {
                        const [y, m, d] = formattedDateStr.split('-');
                        formattedDateStr = `${d}/${m}/${y}`;
                    }
                    if (fault.timeReported) {
                        formattedDateStr += ` alle ${fault.timeReported}`;
                    }

                    return `
                    <div class="gc-fault-card ${cardThemeClass} p-5 flex flex-col justify-between space-y-3 shadow-md">
                        <div class="space-y-3">
                            <!-- Riga Superiore: Titolo Mezzo + Badges a Destra -->
                            <div class="flex justify-between items-start sm:items-center gap-3">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg font-bold flex-shrink-0">
                                        <i class="fa-solid fa-truck"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white font-heading flex items-center gap-2 flex-wrap leading-tight">
                                            <span>${fault.vehicleName}</span>
                                            <span class="px-2 py-0.5 bg-slate-900 text-white rounded-md font-mono text-xs font-black tracking-wider border border-slate-700 whitespace-nowrap">${fault.plate || 'TARGA N/D'}</span>
                                        </h4>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 flex-shrink-0 flex-wrap justify-end">
                                    ${headerBadgesHtml}
                                </div>
                            </div>

                            <!-- Riga Dedicata: Segnalatore & Data a Tutta Larghezza -->
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11.5px] text-slate-500 dark:text-slate-400 pb-0.5">
                                <span class="inline-flex items-center gap-1.5 font-medium text-slate-700 dark:text-slate-300">
                                    <i class="fa-regular fa-user text-amber-500 text-xs"></i>
                                    <span>Segnalato da: <strong class="text-slate-900 dark:text-slate-100">${fault.workerName || 'Operatore'}</strong></span>
                                </span>
                                <span class="text-slate-300 dark:text-slate-600">•</span>
                                <span class="inline-flex items-center gap-1.5 font-medium text-slate-500 dark:text-slate-400">
                                    <i class="fa-regular fa-calendar-check text-slate-400 text-xs"></i>
                                    <span>${formattedDateStr}</span>
                                </span>
                            </div>

                            <!-- Cantiere & Descrizione -->
                            <div class="p-3 bg-slate-50/80 dark:bg-slate-900/60 rounded-xl border border-slate-200/60 dark:border-slate-700/60 text-xs space-y-2">
                                <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400 font-bold text-[11px]">
                                    <i class="fa-solid fa-location-dot text-amber-500"></i>
                                    <span>Luogo / Cantiere: <strong class="text-slate-800 dark:text-slate-200">${fault.cantiere || 'Non specificato'}</strong></span>
                                </div>
                                <div class="pt-1.5 border-t border-slate-200/60 dark:border-slate-700/60 text-slate-800 dark:text-slate-200 leading-relaxed font-medium">
                                    <span class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 block mb-0.5">Descrizione Guasto:</span>
                                    <span>${fault.description || 'Nessuna descrizione specificata.'}</span>
                                </div>
                            </div>

                            <!-- Galleria Foto -->
                            ${photosHtml}
                        </div>

                        <!-- Note Meccanico / Fleet Manager & Azioni -->
                        <div class="mt-auto pt-3 border-t border-slate-100 dark:border-slate-700/60 space-y-2.5">
                            <div class="flex items-center gap-2">
                                <input type="text" id="mechanic-note-${fault.id}" placeholder="Note aggiuntive..."
                                    value="${fault.mechanicNotes || ''}"
                                    class="w-full px-3 py-1.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-800 dark:text-slate-100 focus:outline-none focus:border-amber-500">
                                <button onclick="saveMechanicNotes('${fault.id}')"
                                    class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-xl transition-all whitespace-nowrap cursor-pointer">
                                    Salva
                                </button>
                            </div>

                            <!-- Pulsanti Azione Cambio Stato & Elimina -->
                            <div class="flex items-center justify-between gap-1.5 flex-wrap">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    ${fault.archived ? `
                                        <button onclick="unarchiveFaultReport('${fault.id}')"
                                            class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-xs rounded-xl shadow-xs transition-all flex items-center gap-1.5 cursor-pointer"
                                            title="Ripristina questa segnalazione nella bacheca attiva">
                                            <i class="fa-solid fa-arrow-up-from-bracket text-xs"></i>
                                            <span>Ripristina in Bacheca</span>
                                        </button>
                                    ` : (fault.status === 'Risolto' ? `
                                        <button onclick="updateFaultStatus('${fault.id}', 'Aperta')"
                                            class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-extrabold text-xs rounded-xl transition-all flex items-center gap-1.5 cursor-pointer">
                                            <i class="fa-solid fa-rotate-left text-xs"></i>
                                            <span>Riapri</span>
                                        </button>
                                        <button onclick="archiveFaultReport('${fault.id}')"
                                            class="px-3 py-1.5 bg-amber-500/15 hover:bg-amber-500 text-amber-700 hover:text-white dark:text-amber-300 dark:hover:text-white border border-amber-500/30 font-extrabold text-xs rounded-xl transition-all flex items-center gap-1.5 cursor-pointer"
                                            title="Sposta nell'archivio storico riparazioni con 1 click">
                                            <i class="fa-solid fa-box-archive text-xs"></i>
                                            <span>Archivia</span>
                                        </button>
                                    ` : `
                                        ${fault.status !== 'In Riparazione' ? `
                                            <button onclick="updateFaultStatus('${fault.id}', 'In Riparazione')"
                                                class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-xs rounded-xl shadow-xs transition-all flex items-center gap-1.5 cursor-pointer">
                                                <i class="fa-solid fa-wrench text-xs"></i>
                                                <span>In Riparazione</span>
                                            </button>
                                        ` : ''}

                                        <button onclick="updateFaultStatus('${fault.id}', 'Risolto')"
                                            class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs rounded-xl shadow-xs transition-all flex items-center gap-1.5 cursor-pointer">
                                            <i class="fa-solid fa-circle-check text-xs"></i>
                                            <span>Segna Risolto</span>
                                        </button>
                                    `)}
                                </div>

                                <button onclick="deleteFaultReport('${fault.id}')"
                                    class="p-1.5 text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 rounded-lg transition-colors cursor-pointer"
                                    title="Elimina Segnalazione">
                                    <i class="fa-solid fa-trash-can text-sm"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    `;
                }

                // 1. Separazione in tre categorie: Guasti Attivi, Storico Risolti Non Archiviati, e Archivio
                const nonArchivedFaults = faults.filter(f => !f.archived);
                const archivedFaults = faults.filter(f => !!f.archived).sort((a, b) => {
                    return (b.dateReported || '').localeCompare(a.dateReported || '') || (b.timeReported || '').localeCompare(a.timeReported || '');
                });

                // I Guasti Attivi sono ordinati con priorità ALTA (Fermo Mezzo) in cima!
                const activeFaults = nonArchivedFaults.filter(f => f.status !== 'Risolto').sort((a, b) => {
                    if (a.severity === 'ALTA' && b.severity !== 'ALTA') return -1;
                    if (b.severity === 'ALTA' && a.severity !== 'ALTA') return 1;
                    if (a.severity === 'MEDIA' && b.severity !== 'MEDIA') return -1;
                    if (b.severity === 'MEDIA' && a.severity !== 'MEDIA') return 1;
                    return (b.dateReported || '').localeCompare(a.dateReported || '') || (b.timeReported || '').localeCompare(a.timeReported || '');
                });

                const resolvedFaults = nonArchivedFaults.filter(f => f.status === 'Risolto').sort((a, b) => {
                    return (b.dateReported || '').localeCompare(a.dateReported || '') || (b.timeReported || '').localeCompare(a.timeReported || '');
                });

                const repairFaultsCount = nonArchivedFaults.filter(f => f.status === 'In Riparazione').length;

                // Aggiornamento dinamico contatori nei pulsanti filtro live
                const elCntAll = document.getElementById('filter-cnt-all');
                const elCntActive = document.getElementById('filter-cnt-active');
