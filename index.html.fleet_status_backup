            }

            renderWorkersTable();
        }

        function updateWorkerDashboardResidueValues() {
            const currentWorker = workers.find(w => w.id === selectedWorkerId);
            if (!currentWorker) return;

            const lblFerie = document.getElementById('lbl-ferie-residue');
            const lblPermessi = document.getElementById('lbl-permessi-residui');
            const lblAltre = document.getElementById('lbl-altre-residue');

            if (lblFerie) lblFerie.innerText = `${currentWorker.ferieResidue !== undefined ? currentWorker.ferieResidue : 80} h`;
            if (lblPermessi) lblPermessi.innerText = `${currentWorker.permessiResidui !== undefined ? currentWorker.permessiResidui : 32} h`;
            if (lblAltre) lblAltre.innerText = `${currentWorker.altreResidue !== undefined ? currentWorker.altreResidue : 16} h`;

            checkRemainingBalanceCap();
        }
