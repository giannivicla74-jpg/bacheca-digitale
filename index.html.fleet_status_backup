                const worker = workers.find(w => w.id === p.workerId);
                const workerName = worker ? getWorkerDisplayName(worker) : "Sconosciuto";
                const isSigned = p.status === "Firmata";
                const signedAtStr = p.signedAt ? new Date(p.signedAt).toLocaleDateString('it-IT') + ' ' + new Date(p.signedAt).toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' }) : "-";

                const row = document.createElement('tr');
                row.className = "hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors border-b border-slate-100 dark:border-slate-800/80";
                row.innerHTML = `
                    <td class="px-4 py-3.5 font-extrabold text-slate-900 dark:text-white text-sm">${escapeHtml(workerName)}</td>
                    <td class="px-4 py-3.5 font-semibold text-slate-700 dark:text-slate-300 text-xs">${escapeHtml(p.month)} ${escapeHtml(p.year)}</td>
                    <td class="px-4 py-3.5 font-mono font-bold text-slate-800 dark:text-slate-200 text-xs">€ ${parseFloat(p.netAmount).toFixed(2)}</td>
                    <td class="px-4 py-3.5 text-xs">
                        ${p.hasFile ? `<span class="text-rose-600 dark:text-rose-400 font-semibold"><i class="fa-solid fa-file-pdf mr-1"></i>${escapeHtml(p.fileName)}</span>` : `<span class="text-slate-400 dark:text-slate-500">Riepilogo Digitale</span>`}
                    </td>
                    <td class="px-4 py-3.5">
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold ${isSigned ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/25' : 'bg-amber-500/15 text-amber-800 dark:text-amber-300 border border-amber-500/30'}">
                            <i class="fa-solid ${isSigned ? 'fa-circle-check' : 'fa-clock'} text-[9px]"></i>
                            ${escapeHtml(p.status)}
                        </span>
                    </td>
                    <td class="px-4 py-3.5 font-mono text-[10px] text-slate-500 dark:text-slate-400">${escapeHtml(signedAtStr)}</td>
