                    : `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-extrabold bg-amber-100 dark:bg-amber-950/80 text-amber-950 dark:text-amber-200 border border-amber-300 dark:border-amber-700 shadow-xs"><i class="fa-solid fa-helmet-safety text-xs"></i>Operaio</span>`;

                const deptContent = `<span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold text-slate-900 dark:text-slate-100 bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 shadow-xs">${escapeHtml(dept || 'Generale')}</span>`;

