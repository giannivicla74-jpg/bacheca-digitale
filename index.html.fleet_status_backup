        window.renderVehicleFleetTab = renderVehicleFleetTab;

        // Salvataggio Note Meccanico
        async function saveMechanicNotes(faultId) {
            const input = document.getElementById(`mechanic-note-${faultId}`);
            if (!input) return;
            const notes = input.value.trim();

            const faults = Array.isArray(window.vehicleFaults) ? window.vehicleFaults : [];
            const fault = faults.find(f => f.id === faultId);
            if (fault) {
                fault.mechanicNotes = notes;
                localStorage.setItem('vicla_vehicle_faults', JSON.stringify(faults));
                if (window.viclaCloudDB && window.viclaCloudDB.updateVehicleFault) {
                    await window.viclaCloudDB.updateVehicleFault(faultId, { mechanicNotes: notes });
                }
                showToast("Note aggiuntive salvate!", "success");
            }
        }
        window.saveMechanicNotes = saveMechanicNotes;

        // Aggiorna Stato Guasto (Aperta -> In Riparazione -> Risolto)
        async function updateFaultStatus(faultId, newStatus) {
            const faults = Array.isArray(window.vehicleFaults) ? window.vehicleFaults : [];
            const fault = faults.find(f => f.id === faultId);
            if (!fault) return;

            fault.status = newStatus;
            localStorage.setItem('vicla_vehicle_faults', JSON.stringify(faults));

            // Se guasto risolto, ripristina mezzo ad 'Operativo' se non ha altri guasti aperti
            if (newStatus === 'Risolto' && fault.vehicleId) {
                const otherOpen = faults.some(f => f.vehicleId === fault.vehicleId && f.id !== faultId && f.status !== 'Risolto');
                if (!otherOpen) {
                    const vehicles = Array.isArray(window.vehicles) ? window.vehicles : [];
                    const veh = vehicles.find(v => v.id === fault.vehicleId);
                    if (veh) {
                        veh.status = 'Operativo';
                        localStorage.setItem('vicla_vehicles', JSON.stringify(vehicles));
                        if (window.viclaCloudDB && window.viclaCloudDB.updateVehicle) {
                            window.viclaCloudDB.updateVehicle(veh.id, { status: 'Operativo' }).catch(console.warn);
                        }
                    }
                }
            }

            // Sincronizza su Firestore Cloud
            if (window.viclaCloudDB && window.viclaCloudDB.updateVehicleFault) {
                await window.viclaCloudDB.updateVehicleFault(faultId, { status: newStatus });
            }

            // Notifica all'operaio che ha segnalato il guasto
            if (fault.reportedBy && fault.reportedBy !== 'ADMIN') {
                const notifTitle = `🛠️ Guasto Mezzo ${fault.vehicleName}: ${newStatus.toUpperCase()}`;
                const notifBody = `Il guasto sul mezzo ${fault.vehicleName} (${fault.plate}) è stato aggiornato a: ${newStatus}.`;

                if (typeof window.addNotification === 'function') {
                    window.addNotification({
                        workerId: fault.reportedBy,
                        title: notifTitle,
                        message: notifBody,
                        type: "info",
                        targetTab: "faults"
                    });
                }
                if (window.viclaCloudDB && window.viclaCloudDB.addNotificationCloud) {
                    window.viclaCloudDB.addNotificationCloud({
                        workerId: fault.reportedBy,
                        title: notifTitle,
                        message: notifBody,
                        type: "info",
                        targetTab: "faults"
                    }).catch(console.warn);
                }
                if (typeof window.sendPushToWorker === 'function') {
                    window.sendPushToWorker(fault.reportedBy, {
                        title: notifTitle,
                        body: notifBody,
                        targetTab: "faults"
                    });
                }
            }

            showToast(`Stato guasto aggiornato a: ${newStatus}`, "success");
            renderVehicleFleetTab();
            renderWorkerVehicleFaults();
        }
        window.updateFaultStatus = updateFaultStatus;

        // Archiviazione 1-Click di un guasto risolto
        async function archiveFaultReport(faultId) {
            const faults = Array.isArray(window.vehicleFaults) ? window.vehicleFaults : [];
            const fault = faults.find(f => f.id === faultId);
            if (!fault) return;

            fault.archived = true;
            fault.archivedAt = new Date().toISOString();
            localStorage.setItem('vicla_vehicle_faults', JSON.stringify(faults));

            if (window.viclaCloudDB && window.viclaCloudDB.updateVehicleFault) {
                await window.viclaCloudDB.updateVehicleFault(faultId, { archived: true, archivedAt: fault.archivedAt }).catch(console.warn);
            }

            showToast(`Riparazione ${fault.vehicleName || ''} archiviata con successo! 📦`, "info");
            renderVehicleFleetTab();
            renderWorkerVehicleFaults();
        }
        window.archiveFaultReport = archiveFaultReport;

        // Ripristino 1-Click di un guasto archiviato
        async function unarchiveFaultReport(faultId) {
            const faults = Array.isArray(window.vehicleFaults) ? window.vehicleFaults : [];
            const fault = faults.find(f => f.id === faultId);
            if (!fault) return;

            fault.archived = false;
            delete fault.archivedAt;
            localStorage.setItem('vicla_vehicle_faults', JSON.stringify(faults));

            if (window.viclaCloudDB && window.viclaCloudDB.updateVehicleFault) {
                await window.viclaCloudDB.updateVehicleFault(faultId, { archived: false }).catch(console.warn);
            }

            showToast(`Scheda ${fault.vehicleName || ''} ripristinata in bacheca attiva! 📤`, "success");
            renderVehicleFleetTab();
            renderWorkerVehicleFaults();
        }
        window.unarchiveFaultReport = unarchiveFaultReport;

        // Eliminazione Segnalazione Guasto
        async function deleteFaultReport(faultId) {
            if (!confirm("Sei sicuro di voler eliminare questa segnalazione di guasto?")) return;

            if (Array.isArray(window.vehicleFaults)) {
                window.vehicleFaults = window.vehicleFaults.filter(f => f.id !== faultId);
                localStorage.setItem('vicla_vehicle_faults', JSON.stringify(window.vehicleFaults));
            }
            if (window.viclaCloudDB && window.viclaCloudDB.deleteVehicleFault) {
                await window.viclaCloudDB.deleteVehicleFault(faultId);
            }
            showToast("Segnalazione eliminata.", "info");
            renderVehicleFleetTab();
            renderWorkerVehicleFaults();
        }
        window.deleteFaultReport = deleteFaultReport;

        // Render Guasti nella Scheda Operaio con Layout Pulito, Senza Accavallamenti
