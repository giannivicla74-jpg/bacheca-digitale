        // Modale Aggiungi Mezzo Anagrafica
        function openNewVehicleModal() {
            const modal = document.getElementById('modal-add-vehicle');
            if (modal) modal.classList.remove('hidden');
        }
        window.openNewVehicleModal = openNewVehicleModal;

        function closeNewVehicleModal() {
            const modal = document.getElementById('modal-add-vehicle');
            if (modal) modal.classList.add('hidden');
        }
        window.closeNewVehicleModal = closeNewVehicleModal;

        async function saveNewVehicle(event) {
            event.preventDefault();
            const name = document.getElementById('new-vehicle-name').value.trim();
            const plate = document.getElementById('new-vehicle-plate').value.trim().toUpperCase();
            const type = document.getElementById('new-vehicle-type').value;
            const status = document.getElementById('new-vehicle-status').value;

            if (!name || !plate) {
                showToast("Inserisci nome mezzo e targa.", "warning");
                return;
            }

            const vehId = "VEH_" + Date.now().toString(36).toUpperCase();
            const newVeh = {
                id: vehId,
                name: name,
                plate: plate,
                type: type,
                status: status,
                createdAt: new Date().toISOString()
            };

            if (!Array.isArray(window.vehicles)) window.vehicles = [];
            window.vehicles.push(newVeh);
            localStorage.setItem('vicla_vehicles', JSON.stringify(window.vehicles));

            if (window.viclaCloudDB && window.viclaCloudDB.addVehicle) {
                await window.viclaCloudDB.addVehicle(newVeh);
            }

            showToast(`Mezzo ${name} (${plate}) aggiunto con successo!`, "success");
            closeNewVehicleModal();
            renderVehicleFleetTab();
            populateVehicleSelect();
        }
        window.saveNewVehicle = saveNewVehicle;

        async function toggleVehicleStatus(vehId) {
            const vehicles = Array.isArray(window.vehicles) ? window.vehicles : [];
            const veh = vehicles.find(v => v.id === vehId);
            if (!veh) return;

            const nextStatus = veh.status === 'Operativo'
                ? 'In Riparazione'
                : (veh.status === 'In Riparazione' ? 'Fermo Mezzo' : 'Operativo');

            veh.status = nextStatus;
            localStorage.setItem('vicla_vehicles', JSON.stringify(vehicles));

            if (window.viclaCloudDB && window.viclaCloudDB.updateVehicle) {
                await window.viclaCloudDB.updateVehicle(vehId, { status: nextStatus });
            }

            showToast(`Stato di ${veh.name} impostato a: ${nextStatus}`, "info");
            renderVehicleFleetTab();
            populateVehicleSelect();
        }
        window.toggleVehicleStatus = toggleVehicleStatus;

        async function deleteVehicleFromFleet(vehId) {
            if (!confirm("Sei sicuro di voler rimuovere questo mezzo dal parco mezzi?")) return;

            if (Array.isArray(window.vehicles)) {
                window.vehicles = window.vehicles.filter(v => v.id !== vehId);
                localStorage.setItem('vicla_vehicles', JSON.stringify(window.vehicles));
            }
            if (window.viclaCloudDB && window.viclaCloudDB.deleteVehicle) {
                await window.viclaCloudDB.deleteVehicle(vehId);
            }

            showToast("Mezzo rimosso dal registro.", "info");
            renderVehicleFleetTab();
            populateVehicleSelect();
        }
        window.deleteVehicleFromFleet = deleteVehicleFromFleet;

    </script>
