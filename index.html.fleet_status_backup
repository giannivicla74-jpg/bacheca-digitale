        function filterWorkerNotices(filter) {
            workerFilter = filter;
            const activeColor = currentRole === 'operaio' ? 'text-orange-500' : 'text-teal-600';
            document.getElementById('btn-wn-all').className = filter === 'all' ? `font-bold ${activeColor}` : 'font-bold text-slate-400 hover:text-slate-600';
