        function setSignatureMethod(method) {
            signatureMethod = method;
            const btnDraw = document.getElementById('btn-sig-draw');
            const btnType = document.getElementById('btn-sig-type');
            const containerDraw = document.getElementById('sig-container-draw');
            const containerType = document.getElementById('sig-container-type');

            if (!btnDraw || !btnType || !containerDraw || !containerType) return;

            const isOperaio = currentRole === 'operaio';
            const drawActiveColor = isOperaio ? "bg-orange-100 text-orange-800" : "bg-teal-100 text-teal-800";
            const typeActiveColor = isOperaio ? "bg-orange-100 text-orange-800" : "bg-teal-100 text-teal-800";

            if (method === 'draw') {
                btnDraw.className = `px-2 py-1 ${drawActiveColor} rounded transition-all font-bold`;
                btnType.className = "px-2 py-1 bg-slate-100 text-slate-600 rounded transition-all";
                containerDraw.classList.remove('hidden');
                containerType.classList.add('hidden');
                setTimeout(initSignatureCanvas, 50);
            } else {
                btnDraw.className = "px-2 py-1 bg-slate-100 text-slate-600 rounded transition-all";
                btnType.className = `px-2 py-1 ${typeActiveColor} rounded transition-all font-bold`;
                containerDraw.classList.add('hidden');
                containerType.classList.remove('hidden');

                const currentWorker = workers.find(w => w.id === selectedWorkerId);
                if (currentWorker) {
                    const input = document.getElementById('signature-typed-input');
                    input.value = `${currentWorker.name} ${currentWorker.surname}`;
                    updateSignaturePreview();
                }
            }
        }

        function updateSignaturePreview() {
            const val = document.getElementById('signature-typed-input').value.trim();
            const preview = document.getElementById('signature-typed-preview');
            if (preview) preview.innerText = val ? val : "Digita la firma...";
        }

        // INIZIALIZZAZIONE CANVAS CON ALGORITMO DI SMOOTHING CURVE E RESPONSIVE RESIZE
        function initSignatureCanvas() {
            signatureCanvas = document.getElementById('signature-canvas');
            if (!signatureCanvas) return;

            const rect = signatureCanvas.getBoundingClientRect();
            signatureCanvas.width = rect.width;
            signatureCanvas.height = rect.height;

            sigContext = signatureCanvas.getContext('2d');
            sigContext.strokeStyle = "#0f2b5c";
            sigContext.lineWidth = 3.0;
            sigContext.lineCap = "round";
            sigContext.lineJoin = "round";

            function getMousePos(e) {
                const r = signatureCanvas.getBoundingClientRect();
                return {
                    x: (e.clientX || e.touches[0].clientX) - r.left,
                    y: (e.clientY || e.touches[0].clientY) - r.top
                };
            }

            function startDrawing(e) {
                isDrawing = true;
                const pos = getMousePos(e);
                lastX = pos.x;
                lastY = pos.y;
                sigContext.beginPath();
                sigContext.moveTo(lastX, lastY);
                if (e.cancelable) e.preventDefault();
            }

            function draw(e) {
                if (!isDrawing) return;
                const pos = getMousePos(e);

                const midX = (lastX + pos.x) / 2;
                const midY = (lastY + pos.y) / 2;

                sigContext.quadraticCurveTo(lastX, lastY, midX, midY);
                sigContext.stroke();

                lastX = pos.x;
                lastY = pos.y;
                if (e.cancelable) e.preventDefault();
            }

            function stopDrawing() {
                if (isDrawing) {
                    sigContext.lineTo(lastX, lastY);
                    sigContext.stroke();
                    isDrawing = false;
                }
            }

            signatureCanvas.onmousedown = startDrawing;
            signatureCanvas.onmousemove = draw;
            signatureCanvas.onmouseup = stopDrawing;
            signatureCanvas.onmouseleave = stopDrawing;

            signatureCanvas.ontouchstart = startDrawing;
            signatureCanvas.ontouchmove = draw;
            signatureCanvas.ontouchend = stopDrawing;
        }

        function clearSignatureCanvas() {
            if (sigContext && signatureCanvas) {
                sigContext.clearRect(0, 0, signatureCanvas.width, signatureCanvas.height);
            }
        }
    </script>

