            return notifications.filter(isNotificationForCurrentUser);
        }
        if (typeof window !== 'undefined') {
            window.getFilteredNotificationsForCurrentUser = getFilteredNotificationsForCurrentUser;
            window.dispatchBrowserPushNotification = dispatchBrowserPushNotification;
