        // STATO E GESTIONE FILTRI AVANZATI FERIE & PERMESSI (STILE GC CODELAB & SCADENZIARIO)
        let leaveFilterView = 'active'; // 'active' (In Corso & Futuri), 'archived' (Archivio Storico), 'all' (Tutti)
        let leaveFilterYear = 'all';    // 'all' o anno specifico es. '2026'
        let leaveFilterMonth = 'all';   // 'all' o mese 0..11
        let leaveSearchQuery = '';      // ricerca testuale dipendente/cantiere/motivo

        // Determina se una richiesta è archiviata
        function isLeaveRequestArchived(r) {
            if (r.archived === true) return true;
            if (r.archived === false) return false;
            // Se ancora 'In attesa', deve rimanere sempre attiva in bacheca
            if (r.status === 'In attesa') return false;
            const todayStr = new Date().toISOString().split('T')[0];
            const reqDate = r.dateEnd || r.datePermesso || r.dateRequested || '';
            return reqDate < todayStr;
        }

        // Switch Vista Principale (In Corso & Futuri / Archivio Storico / Tutti)
        function setLeaveView(view) {
            leaveFilterView = view;
            ['active', 'archived', 'all'].forEach(v => {
                const btn = document.getElementById('btnLeaveView' + v.charAt(0).toUpperCase() + v.slice(1));
                if (btn) {
                    if (v === view) {
                        btn.className = "flex-1 md:flex-none px-3.5 py-1.5 rounded-lg text-xs font-extrabold transition cursor-pointer flex items-center justify-center gap-1.5 bg-blue-600 text-white shadow-sm";
                    } else {
                        btn.className = "flex-1 md:flex-none px-3.5 py-1.5 rounded-lg text-xs font-extrabold transition cursor-pointer flex items-center justify-center gap-1.5 text-slate-400 hover:text-white";
                    }
                }
            });
            renderAdminRequestsTab();
        }
        window.setLeaveView = setLeaveView;

        function handleLeaveYearChange(year) {
            leaveFilterYear = year;
            updateLeaveQuickPeriodHighlight();
            renderAdminRequestsTab();
        }
        window.handleLeaveYearChange = handleLeaveYearChange;

        function handleLeaveMonthChange(month) {
            leaveFilterMonth = month;
            updateLeaveQuickPeriodHighlight();
            renderAdminRequestsTab();
        }
        window.handleLeaveMonthChange = handleLeaveMonthChange;

        function handleLeaveSearch(q) {
            leaveSearchQuery = (q || '').trim().toLowerCase();
            const btnClear = document.getElementById('btnLeaveClearSearch');
            if (btnClear) {
                if (leaveSearchQuery.length > 0) {
                    btnClear.classList.remove('hidden');
                } else {
                    btnClear.classList.add('hidden');
                }
            }
            renderAdminRequestsTab();
        }
        window.handleLeaveSearch = handleLeaveSearch;

        function clearLeaveSearch() {
            const input = document.getElementById('leaveSearchInput');
            if (input) input.value = '';
            leaveSearchQuery = '';
            const btnClear = document.getElementById('btnLeaveClearSearch');
            if (btnClear) btnClear.classList.add('hidden');
            renderAdminRequestsTab();
        }
        window.clearLeaveSearch = clearLeaveSearch;

        // Pulsanti rapidi temporali (Questo Mese, Mese Scorso, Quest'Anno, Tutto)
        function setLeaveQuickPeriod(period) {
            const today = new Date();
            const curYear = today.getFullYear().toString();
            const curMonth = today.getMonth().toString();

            const yearSel = document.getElementById('leaveYearFilter');
            const monthSel = document.getElementById('leaveMonthFilter');

            if (period === 'thisMonth') {
                leaveFilterYear = curYear;
                leaveFilterMonth = curMonth;
            } else if (period === 'lastMonth') {
                const lastM = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                leaveFilterYear = lastM.getFullYear().toString();
                leaveFilterMonth = lastM.getMonth().toString();
            } else if (period === 'thisYear') {
                leaveFilterYear = curYear;
                leaveFilterMonth = 'all';
            } else { // 'all'
                leaveFilterYear = 'all';
                leaveFilterMonth = 'all';
                clearLeaveSearch();
            }

            if (yearSel) yearSel.value = leaveFilterYear;
            if (monthSel) monthSel.value = leaveFilterMonth;
            updateLeaveQuickPeriodHighlight(period);
            renderAdminRequestsTab();
        }
        window.setLeaveQuickPeriod = setLeaveQuickPeriod;

        function updateLeaveQuickPeriodHighlight(activePeriod = null) {
            ['thisMonth', 'lastMonth', 'thisYear', 'all'].forEach(p => {
                const btn = document.getElementById('btnLeaveQuick' + p.charAt(0).toUpperCase() + p.slice(1));
                if (!btn) return;
                if (p === activePeriod) {
                    btn.className = "px-2.5 py-1 rounded-lg text-[11px] font-bold bg-blue-600 text-white shadow-xs transition cursor-pointer";
                } else {
                    btn.className = "px-2.5 py-1 rounded-lg text-[11px] font-bold bg-slate-800/90 hover:bg-slate-700 text-slate-300 transition cursor-pointer";
                }
            });
        }

        // Toggle archiviazione singola richiesta (1-Click)
        function toggleLeaveRequestArchive(reqId) {
            const req = leaveRequests.find(r => r.id === reqId);
            if (!req) return;
            const currentArchived = isLeaveRequestArchived(req);
            req.archived = !currentArchived;
            localStorage.setItem('vicla_leave_requests', JSON.stringify(leaveRequests));

            if (window.viclaCloudDB && window.viclaCloudDB.updateLeaveRequest) {
                window.viclaCloudDB.updateLeaveRequest(reqId, { ...req, archived: req.archived }).catch(console.warn);
            }

            showToast(req.archived ? `Richiesta ${req.id} spostata in Archivio Storico 📦` : `Richiesta ${req.id} ripristinata in elenco attivo 📤`, "info");
            renderAdminRequestsTab();
        }
        window.toggleLeaveRequestArchive = toggleLeaveRequestArchive;

        // Archiviazione di massa con 1 clic per tutte le richieste concluse nel passato
        function archiveAllConcludedLeaveRequests() {
            const todayStr = new Date().toISOString().split('T')[0];
            let count = 0;
            leaveRequests.forEach(r => {
                const reqDate = r.dateEnd || r.datePermesso || r.dateRequested || '';
                if (reqDate < todayStr && (r.status === 'Approvata' || r.status === 'Rifiutata') && !r.archived) {
                    r.archived = true;
                    count++;
                }
            });

            if (count === 0) {
                showToast("Tutte le richieste concluse nel passato sono già archiviate.", "info");
                return;
            }

            localStorage.setItem('vicla_leave_requests', JSON.stringify(leaveRequests));
            showToast(`✓ ${count} richieste storiche spostate in Archivio Storico!`, "success");
            renderAdminRequestsTab();
        }
        window.archiveAllConcludedLeaveRequests = archiveAllConcludedLeaveRequests;

        // Filtro Stato (Tutte / In attesa / Approvata / Rifiutata)
        function filterAdminRequests(status) {
            adminRequestFilter = status;

            const filters = ['all', 'pending', 'approved', 'rejected'];
            const statusMap = { 'Tutte': 'all', 'In attesa': 'pending', 'Approvata': 'approved', 'Rifiutata': 'rejected' };

            filters.forEach(f => {
                const btn = document.getElementById(`btn-req-filter-${f}`);
                if (btn) {
                    btn.className = "px-2.5 py-1 rounded-lg text-xs font-bold transition-all text-slate-400 hover:text-white bg-slate-950/80 hover:bg-slate-800 cursor-pointer";
                }
            });

            const activeBtn = document.getElementById(`btn-req-filter-${statusMap[status]}`);
            if (activeBtn) {
                activeBtn.className = "px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-blue-900 text-white shadow-xs cursor-pointer";
            }

            renderAdminRequestsTab();
        }
        window.filterAdminRequests = filterAdminRequests;

        // Render Registro Richieste con filtri a cascata intelligenti
        function renderAdminRequestsTab() {
            const tableBody = document.getElementById('admin-requests-table-body');
            if (!tableBody) return;
            tableBody.innerHTML = '';

            // 1. Calcolo metriche per i badge contatori delle 3 viste
            const activeRequestsList = leaveRequests.filter(r => !isLeaveRequestArchived(r));
            const archivedRequestsList = leaveRequests.filter(r => isLeaveRequestArchived(r));
            const allRequestsCount = leaveRequests.length;

            const bActive = document.getElementById('badgeCountLeaveActive');
            const bArchived = document.getElementById('badgeCountLeaveArchived');
            const bAll = document.getElementById('badgeCountLeaveAll');
            if (bActive) bActive.textContent = activeRequestsList.length;
            if (bArchived) bArchived.textContent = archivedRequestsList.length;
            if (bAll) bAll.textContent = allRequestsCount;

            const badgePendingCount = document.getElementById('admin-req-count-badge');
            const pendingRequests = leaveRequests.filter(r => r.status === "In attesa").length;
            if (badgePendingCount) {
                if (pendingRequests > 0) {
                    badgePendingCount.innerText = pendingRequests;
                    badgePendingCount.classList.remove('hidden');
                } else {
                    badgePendingCount.classList.add('hidden');
                }
            }

            // 2. Popola dinamicamente il dropdown Anni disponibili
            const yearSel = document.getElementById('leaveYearFilter');
            if (yearSel) {
                const curVal = yearSel.value || leaveFilterYear;
                const years = new Set();
                leaveRequests.forEach(r => {
                    const d = r.datePermesso || r.dateRequested || '';
                    if (d.length >= 4) years.add(d.substring(0, 4));
                });
                const curYearStr = new Date().getFullYear().toString();
                years.add(curYearStr);
                const sortedYears = Array.from(years).sort().reverse();
                let optionsHtml = '<option value="all">Tutti gli anni</option>';
                sortedYears.forEach(y => {
                    optionsHtml += `<option value="${y}">${y}</option>`;
                });
                yearSel.innerHTML = optionsHtml;
                yearSel.value = curVal;
            }

            // 3. Filtraggio avanzato multi-criterio
            const filteredRequests = leaveRequests.filter(r => {
                const isArchived = isLeaveRequestArchived(r);

                // A. Switch Vista Principale
                if (leaveFilterView === 'active' && isArchived) return false;
                if (leaveFilterView === 'archived' && !isArchived) return false;

                // B. Filtro Stato Richiesta
                if (adminRequestFilter !== 'Tutte' && r.status !== adminRequestFilter) return false;

                // C. Filtro per Anno
                const reqDate = r.datePermesso || r.dateRequested || '';
                if (leaveFilterYear !== 'all') {
                    if (!reqDate.startsWith(leaveFilterYear)) return false;
                }

                // D. Filtro per Mese (0..11)
                if (leaveFilterMonth !== 'all') {
                    const targetM = parseInt(leaveFilterMonth, 10);
                    if (reqDate.length >= 7) {
                        const reqM = parseInt(reqDate.substring(5, 7), 10) - 1;
                        if (reqM !== targetM) return false;
                    } else {
                        return false;
                    }
                }

                // E. Ricerca Testuale (Dipendente, Reparto, Cantiere, Motivo, ID)
                if (leaveSearchQuery) {
                    const worker = workers.find(w => w.id === r.workerId);
                    const wName = worker ? `${worker.surname || ''} ${worker.name || ''} ${worker.matricola || ''} ${worker.department || ''}`.toLowerCase() : '';
                    const cantiere = (r.cantiere || '').toLowerCase();
                    const reason = (r.reason || '').toLowerCase();
                    const idStr = (r.id || '').toLowerCase();
                    const fullHaystack = `${wName} ${cantiere} ${reason} ${idStr}`;
                    if (!fullHaystack.includes(leaveSearchQuery)) return false;
                }

                return true;
            });

            // 4. Calcolo metriche di riepilogo del periodo filtrato (Giorni & Ore)
            let periodTotalDays = 0;
            let periodTotalHours = 0;
            filteredRequests.forEach(r => {
                const hours = parseFloat(r.hoursNum) || 0;
                periodTotalHours += hours;
                if (r.dateEnd && r.datePermesso && r.dateEnd !== r.datePermesso) {
                    const d = Math.max(1, Math.round((new Date(r.dateEnd) - new Date(r.datePermesso)) / (1000 * 60 * 60 * 24)) + 1);
                    periodTotalDays += d;
                } else if (hours >= 8) {
                    periodTotalDays += Math.max(1, Math.round(hours / 8));
                } else if (hours > 0) {
                    periodTotalDays += 1;
                }
            });

            const summaryEl = document.getElementById('leavePeriodSummary');
            if (summaryEl) {
                let searchPill = '';
                if (leaveSearchQuery) {
                    searchPill = `
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold shadow-xs">
                            <i class="fa-solid fa-filter text-[10px] text-amber-400"></i>
                            <span>"<strong>${escapeHtml(leaveSearchQuery)}</strong>"</span>
                            <button type="button" onclick="clearLeaveSearch()" class="px-1 py-0.5 ml-0.5 bg-amber-500/30 hover:bg-amber-500 text-white rounded text-[10px] cursor-pointer transition">
                                <i class="fa-solid fa-xmark text-[9px]"></i>
                            </button>
                        </span>
                    `;
                }

                summaryEl.innerHTML = `
                    ${searchPill}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-950/80 border border-blue-800/70 text-blue-300 font-extrabold text-xs shadow-xs">
                        <i class="fa-regular fa-calendar-days text-blue-400 text-xs"></i>
                        <span>${periodTotalDays} gg</span>
                        <span class="text-blue-500/60 font-normal">•</span>
                        <span class="text-blue-200 font-mono">${periodTotalHours} ore</span>
                    </span>
                `;
            }

            // 5. Rendering righe della tabella
            if (filteredRequests.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="7" class="px-4 py-12 text-center text-slate-400">
                            <i class="fa-solid fa-box-open text-3xl mb-2 block text-slate-500"></i>
                            <span class="font-bold text-sm block">Nessuna richiesta trovata per i filtri selezionati</span>
                            <span class="text-xs text-slate-500 mt-1 block">Prova a selezionare "Tutti gli anni", "Tutti i mesi" o a cancellare il testo cercato.</span>
                        </td>
                    </tr>
                `;
                return;
            }

            const sortedRequests = [...filteredRequests].sort((a, b) => new Date(b.dateRequested || b.datePermesso) - new Date(a.dateRequested || a.datePermesso));
            sortedRequests.forEach(req => {
                const worker = workers.find(w => w.id === req.workerId);
                const workerName = worker ? getWorkerDisplayName(worker) : "Sconosciuto";
                const workerClass = worker ? formatWorkerCategory(worker) : "-";
                const workerDept = worker ? formatWorkerDept(worker) : "";
                const classBadge = workerClass === 'Dipendente'
                    ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-500/15 text-teal-700 dark:text-teal-300 border border-teal-500/25"><i class="fa-solid fa-id-card text-[8px]"></i>Dip.</span>`
                    : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/15 text-amber-800 dark:text-amber-300 border border-amber-500/30"><i class="fa-solid fa-helmet-safety text-[8px]"></i>Ope.</span>`;

                let statusBadgeClass, statusIcon;
                if (req.status === "Approvata") {
                    statusBadgeClass = "bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/25";
                    statusIcon = "fa-circle-check";
                } else if (req.status === "Rifiutata") {
                    statusBadgeClass = "bg-rose-500/15 text-rose-700 dark:text-rose-300 border border-rose-500/25";
                    statusIcon = "fa-circle-xmark";
                } else {
                    statusBadgeClass = "bg-amber-500/15 text-amber-800 dark:text-amber-300 border border-amber-500/30";
                    statusIcon = "fa-clock";
                }

                const isArchived = isLeaveRequestArchived(req);
                const archivedBadge = isArchived
                    ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30 ml-1"><i class="fa-solid fa-box-archive text-[8px]"></i>Archiviata</span>`
                    : '';

                const datePermessoFormatted = new Date(req.datePermesso).toLocaleDateString('it-IT');

                const row = document.createElement('tr');
                row.className = `hover:bg-slate-100/80 dark:hover:bg-slate-800/60 transition-colors border-b border-slate-100 dark:border-slate-800/80 align-middle ${isArchived ? 'opacity-85' : ''}`;
                row.innerHTML = `
                    <td class="px-4 py-3.5">
                        <div class="font-extrabold text-slate-900 dark:text-white text-sm flex items-center gap-1.5 flex-wrap">
                            <span>${escapeHtml(workerName)}</span>
                            ${archivedBadge}
                        </div>
                        <div class="flex items-center gap-1.5 mt-1">${classBadge} <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">${escapeHtml(workerDept)}</span></div>
                    </td>
                    <td class="px-4 py-3.5 font-semibold text-slate-700 dark:text-slate-300 text-xs whitespace-nowrap">${escapeHtml(datePermessoFormatted)}</td>
                    <td class="px-4 py-3.5 font-mono text-xs whitespace-nowrap">
                        <span class="font-bold text-slate-900 dark:text-white">${escapeHtml(req.fromHour)} - ${escapeHtml(req.toHour)}</span>
                        <div class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5 font-medium">Totale: ${parseFloat(req.hoursNum) || 0} ore</div>
                    </td>
                    <td class="px-4 py-3.5 text-xs text-slate-700 dark:text-slate-300 font-semibold">${escapeHtml(req.cantiere || "-")}</td>
                    <td class="px-4 py-3.5 text-xs text-slate-600 dark:text-slate-400 italic max-w-[140px] truncate" title="${escapeHtml(req.reason)}">${escapeHtml(req.reason)}</td>
                    <td class="px-4 py-3.5 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold ${statusBadgeClass}">
                            <i class="fa-solid ${statusIcon} text-[9px]"></i>
                            ${escapeHtml(req.status)}
                        </span>
                    </td>
                    <td class="px-4 py-3.5 text-right whitespace-nowrap">
                        <div class="flex items-center justify-end gap-1.5">
                            <button onclick="selectRequestForElaboration('${escapeHtml(req.id)}')"
                                class="px-3 py-1.5 bg-blue-900 hover:bg-blue-950 dark:bg-blue-700 dark:hover:bg-blue-600 text-white rounded-xl text-xs font-bold transition-all shadow-sm hover:shadow-md flex items-center gap-1 cursor-pointer">
                                <i class="fa-solid fa-file-signature text-xs"></i>
                                <span>Elabora MD6</span>
                            </button>
                            <button onclick="toggleLeaveRequestArchive('${escapeHtml(req.id)}')"
                                class="p-1.5 rounded-xl border ${isArchived ? 'bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 border-amber-300 dark:border-amber-700 hover:bg-amber-100' : 'bg-slate-100 dark:bg-slate-800 text-slate-400 hover:text-amber-500 border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700'} transition cursor-pointer"
                                title="${isArchived ? 'Ripristina in elenco attivo' : 'Sposta in Archivio Storico'}">
                                <i class="fa-solid ${isArchived ? 'fa-arrow-up-from-bracket' : 'fa-box-archive'} text-xs"></i>
                            </button>
                        </div>
                    </td>
                `;
                tableBody.appendChild(row);
            });
        }
    </script>

    <script>
        function exportWorkersToCSV() {
            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "Matricola,Cognome,Nome,Classe,Livello,Reparto,Ferie Residue (h),Permessi Residui (h),Altre Residue (h),Totale Ore Residue (h)\n";

            workers.forEach(w => {
                const f = parseFloat(w.ferieResidue !== undefined ? w.ferieResidue : 80) || 0;
                const p = parseFloat(w.permessiResidui !== undefined ? w.permessiResidui : 32) || 0;
                const a = parseFloat(w.altreResidue !== undefined ? w.altreResidue : 16) || 0;
                const tot = f + p + a;
                const row = `"${w.matricola || w.id}","${w.surname || ''}","${w.name || ''}","${w.category || 'Operaio'}","${w.livello || '5° Livello'}","${w.department || 'Produzione'}",${f},${p},${a},${tot}`;
                csvContent += row + "\n";
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "Saldi_Ore_Personale_ViCla_Future.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("Esportazione saldi completata con successo!", "success");
        }

        function exportRequestsToCSV() {
            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "ID Richiesta,Dipendente,Data Richiesta,Data Permesso,Da Ora,A Ora,Totale Ore,Tipo,Motivo,Stato,Esigenza Cantiere,Firma DTC,Firma RAM,Firma AU\n";

            leaveRequests.forEach(r => {
                const worker = workers.find(w => w.id === r.workerId);
                const fullName = worker ? `${worker.surname} ${worker.name}` : "Sconosciuto";
                const row = `"${r.id}","${fullName}","${r.dateRequested}","${r.datePermesso}","${r.fromHour}","${r.toHour}",${r.hoursNum},"${r.leaveType}","${r.reason}","${r.status}","${r.techEsigenza || ''}","${r.techFirma || ''}","${r.adminFirmaRAM || ''}","${r.adminFirmaAU || ''}"`;
                csvContent += row + "\n";
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "Storico_Richieste_Permessi_ViCla_Future.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("Esportazione storico completata con successo!", "success");
        }

        function toggleAddWorkerForm() {
            const form = document.getElementById('form-add-worker');
            if (form) form.classList.toggle('hidden');
        }

        function toggleDarkMode() {
            try {
                document.documentElement.classList.toggle('dark-mode');
                document.documentElement.classList.toggle('dark');
                const icon = document.querySelector('#btn-dark-mode i');

                const isDark = document.documentElement.classList.contains('dark-mode');
                localStorage.setItem('vicla_dark_mode', isDark ? 'true' : 'false');

                if (icon) {
                    if (isDark) {
                        icon.classList.remove('fa-moon', 'text-indigo-500');
                        icon.classList.add('fa-sun', 'text-amber-500');
                    } else {
                        icon.classList.remove('fa-sun', 'text-amber-500');
                        icon.classList.add('fa-moon', 'text-indigo-500');
                    }
                }
            } catch (e) {
                console.error("Dark mode toggle error:", e);
            }
        }

        // Load dark mode preference
        if (localStorage.getItem('vicla_dark_mode') === 'true') {
            document.documentElement.classList.add('dark-mode', 'dark');
            const icon = document.querySelector('#btn-dark-mode i');
            if (icon) {
                icon.classList.remove('fa-moon', 'text-indigo-500');
                icon.classList.add('fa-sun', 'text-amber-500');
            }
        }

        function saveNewWorker() {
            const name = document.getElementById('add-worker-name').value.trim();
            const surname = document.getElementById('add-worker-surname').value.trim();
            const matricola = document.getElementById('add-worker-matricola').value.trim();
            const cantiere = document.getElementById('add-worker-cantiere').value.trim();
            const category = document.getElementById('add-worker-category').value;
            const dept = document.getElementById('add-worker-department').value;
            const pin = document.getElementById('add-worker-pin').value.trim() || "1234";
            const livello = document.getElementById('add-worker-livello').value.trim() || "5° Livello";

            const ferie = parseFloat(document.getElementById('add-worker-ferie').value) || 0;
            const permessi = parseFloat(document.getElementById('add-worker-permessi').value) || 0;
            const altre = parseFloat(document.getElementById('add-worker-altre').value) || 0;

            if (!name || !surname || !matricola) {
                showToast("Inserire Nome, Cognome e Matricola validi", "warning");
                return;
            }

            const nextId = "W" + String(workers.length + 1).padStart(2, '0');
            const newWorker = {
                id: nextId,
                name: name,
                surname: surname,
                matricola: matricola,
                cantiere: cantiere || (category === 'Dipendente' ? "Sede Amministrativa" : "Cantiere Sede"),
                category: category,
                livello: livello,
                department: dept,
                pin: pin,
                ferieResidue: ferie,
                permessiResidui: permessi,
                altreResidue: altre
            };

            workers.push(newWorker);
            localStorage.setItem('vicla_workers', JSON.stringify(workers));

            document.getElementById('add-worker-name').value = '';
            document.getElementById('add-worker-surname').value = '';
            document.getElementById('add-worker-matricola').value = '';
            document.getElementById('add-worker-cantiere').value = '';
            document.getElementById('add-worker-pin').value = '1234';
            document.getElementById('add-worker-livello').value = '5° Livello';
            document.getElementById('add-worker-ferie').value = '80';
            document.getElementById('add-worker-permessi').value = '32';
            document.getElementById('add-worker-altre').value = '16';
            toggleAddWorkerForm();

            showToast(`${category} ${surname} ${name} registrato!`, "success");
            renderAdminDashboard();
        }

        let currentEditingWorkerId = null;

        function toggleEditWorkerForm() {
            const form = document.getElementById('form-edit-worker-container');
            if (form) form.classList.toggle('hidden');
        }

        function openEditWorkerForm(workerId) {
            const worker = workers.find(w => w.id === workerId);
            if (!worker) return;

            currentEditingWorkerId = workerId;

            document.getElementById('edit-worker-name').value = worker.name || '';
            document.getElementById('edit-worker-surname').value = worker.surname || '';
            document.getElementById('edit-worker-matricola').value = worker.matricola || '';
            document.getElementById('edit-worker-cantiere').value = worker.cantiere || '';
            document.getElementById('edit-worker-category').value = worker.category || 'Operaio';
            document.getElementById('edit-worker-department').value = worker.department || 'Amministrazione';
            document.getElementById('edit-worker-pin').value = worker.pin || '1234';
            document.getElementById('edit-worker-livello').value = worker.livello || '5° Livello';
            document.getElementById('edit-worker-ferie').value = worker.ferieResidue !== undefined ? worker.ferieResidue : 80;
            document.getElementById('edit-worker-permessi').value = worker.permessiResidui !== undefined ? worker.permessiResidui : 32;
            document.getElementById('edit-worker-altre').value = worker.altreResidue !== undefined ? worker.altreResidue : 16;

            const form = document.getElementById('form-edit-worker-container');
            if (form) form.classList.remove('hidden');

            // Scroll down a bit to see it if needed
            form.scrollIntoView({ behavior: "smooth", block: "center" });
        }

        function saveEditedWorker() {
            if (!currentEditingWorkerId) return;

            const name = document.getElementById('edit-worker-name').value.trim();
            const surname = document.getElementById('edit-worker-surname').value.trim();
            const matricola = document.getElementById('edit-worker-matricola').value.trim();
            const cantiere = document.getElementById('edit-worker-cantiere').value.trim();
            const category = document.getElementById('edit-worker-category').value;
            const dept = document.getElementById('edit-worker-department').value;
            const pin = document.getElementById('edit-worker-pin').value.trim();
            const livello = document.getElementById('edit-worker-livello').value.trim() || "5° Livello";

            const ferie = parseFloat(document.getElementById('edit-worker-ferie').value) || 0;
            const permessi = parseFloat(document.getElementById('edit-worker-permessi').value) || 0;
            const altre = parseFloat(document.getElementById('edit-worker-altre').value) || 0;

            if (!name || !surname || !matricola) {
                showToast("Inserire Nome, Cognome e Matricola validi", "warning");
                return;
            }

            const index = workers.findIndex(w => w.id === currentEditingWorkerId);
            if (index !== -1) {
                workers[index] = {
                    ...workers[index],
                    name: name,
                    surname: surname,
                    matricola: matricola,
                    cantiere: cantiere,
                    category: category,
                    livello: livello,
                    department: dept,
                    pin: pin,
                    ferieResidue: ferie,
                    permessiResidui: permessi,
                    altreResidue: altre
                };

                localStorage.setItem('vicla_workers', JSON.stringify(workers));
                showToast(`Anagrafica ${name} aggiornata!`, "success");

                // Trigger Firebase save if monkey patch exists
                if (window.triggerSaveEditedWorkerToCloud) {
                    window.triggerSaveEditedWorkerToCloud(workers[index]);
                }
            }

            currentEditingWorkerId = null;
            toggleEditWorkerForm();
            renderAdminDashboard();
        }

        function confirmDeleteWorker(workerId) {
            const worker = workers.find(w => w.id === workerId);
            if (!worker) return;

            showConfirmDialog(
                "Rimuovere Dipendente?",
                `Sei sicuro di rimuovere ${worker.surname} ${worker.name}? Verranno cancellati tutti i suoi dati dal portale.`,
                function () {
                    const index = workers.findIndex(w => w.id === workerId);
                    if (index !== -1) {
                        workers.splice(index, 1);
                        localStorage.setItem('vicla_workers', JSON.stringify(workers));
                        showToast(`Collaboratore rimosso con successo.`, "warning");
                        renderAdminDashboard();
                    }
                }
            );
        }
    </script>

    <script>
        function selectRequestForElaboration(reqId) {
            selectedRequestIdForElaboration = reqId;
            window.selectedRequestIdForElaboration = reqId;
            const req = leaveRequests.find(r => r.id === reqId);
            if (!req) return;

            const worker = workers.find(w => w.id === req.workerId);
            const fullName = worker ? `${worker.surname} ${worker.name}` : (req.workerId || "Sconosciuto");

            // 1. Nome Lavoratore nell'Header
            const workerNameEl = document.getElementById('elb-worker-name');
            if (workerNameEl) workerNameEl.innerText = fullName;

            // Mostra la scheda di elaborazione
            const cardEl = document.getElementById('request-elaborate-card');
            if (cardEl) cardEl.classList.remove('hidden');

            // 2. Badge ID Richiesta & Tipo
            const reqIdBadge = document.getElementById('elb-req-id-badge');
            if (reqIdBadge) reqIdBadge.innerText = req.id || "MD6";

            const leaveType = req.leaveType || "Permesso";
            const leaveTypeEl = document.getElementById('elb-leave-type');
            if (leaveTypeEl) leaveTypeEl.innerText = leaveType;

            const leaveTypeBadge = document.getElementById('elb-leave-type-badge');
            if (leaveTypeBadge) {
                if (leaveType === 'Ferie') {
                    leaveTypeBadge.className = "px-3 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-emerald-600 dark:bg-emerald-700 text-white shadow-xs flex items-center gap-1.5";
                    leaveTypeBadge.innerHTML = `<i class="fa-solid fa-umbrella-beach"></i> <span id="elb-leave-type">Ferie</span>`;
                } else {
                    leaveTypeBadge.className = "px-3 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-blue-900 dark:bg-blue-600 text-white shadow-xs flex items-center gap-1.5";
                    leaveTypeBadge.innerHTML = `<i class="fa-solid fa-clock"></i> <span id="elb-leave-type">${leaveType}</span>`;
                }
            }

            // 3. Data Invio & Badge Stato
            const dateReqEl = document.getElementById('elb-date-requested');
            if (dateReqEl) {
                if (req.dateRequested) {
                    const dParts = req.dateRequested.split('-');
                    dateReqEl.innerText = dParts.length === 3 ? `${dParts[2]}/${dParts[1]}/${dParts[0]}` : req.dateRequested;
                } else {
                    dateReqEl.innerText = "--";
                }
            }

            const statusBadge = document.getElementById('elb-status-badge');
            if (statusBadge) {
                statusBadge.innerText = req.status || "In attesa";
                if (req.status === 'Approvata') {
                    statusBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800";
                } else if (req.status === 'Rifiutata') {
                    statusBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-300 dark:border-rose-800";
                } else {
                    statusBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-300 dark:border-amber-800";
                }
            }

            // 4. Giorno / Periodo
            const dateDisplayEl = document.getElementById('elb-date-display');
            const dateSubtextEl = document.getElementById('elb-date-subtext');
            const fmtDate = (dStr) => {
                if (!dStr) return "--";
                const parts = dStr.split('-');
                return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : dStr;
            };

            const isMultiDay = req.dateEnd && req.dateEnd !== req.datePermesso;
            if (dateDisplayEl) {
                if (isMultiDay) {
                    dateDisplayEl.innerText = `${fmtDate(req.datePermesso)} → ${fmtDate(req.dateEnd)}`;
                    if (dateSubtextEl) {
                        const d1 = new Date(req.datePermesso);
                        const d2 = new Date(req.dateEnd);
                        const days = !isNaN(d1) && !isNaN(d2) ? Math.round(Math.abs(d2 - d1)/(1000*60*60*24)) + 1 : 1;
                        dateSubtextEl.innerText = `Periodo continuativo di ${days} giorni`;
                    }
                } else {
                    const dObj = new Date(req.datePermesso);
                    const dayName = !isNaN(dObj) ? dObj.toLocaleDateString('it-IT', { weekday: 'long' }) : '';
                    const dayCapitalized = dayName ? dayName.charAt(0).toUpperCase() + dayName.slice(1) + ' ' : '';
                    dateDisplayEl.innerText = `${dayCapitalized}${fmtDate(req.datePermesso)}`;
                    if (dateSubtextEl) dateSubtextEl.innerText = "Singola giornata lavorativa";
                }
            }

            // 5. Fascia Oraria
            const hoursRangeEl = document.getElementById('elb-hours-range');
            const hoursRangeSubtextEl = document.getElementById('elb-hours-range-subtext');
            if (hoursRangeEl) {
                if (req.fromHour && req.toHour && req.fromHour !== "--:--" && req.toHour !== "--:--") {
                    hoursRangeEl.innerText = `Dalle ${req.fromHour} alle ${req.toHour}`;
                    if (hoursRangeSubtextEl) hoursRangeSubtextEl.innerText = "Assenza oraria programmata";
                } else {
                    hoursRangeEl.innerText = "Intera Giornata";
                    if (hoursRangeSubtextEl) hoursRangeSubtextEl.innerText = "Assenza turno completo";
                }
            }

            // 6. Ore Totali & Saldo Residuo
            const hoursNumEl = document.getElementById('elb-hours-num');
            if (hoursNumEl) hoursNumEl.innerText = `${req.hoursNum || 0} ore`;

            const tipoAssenza = req.leaveType || "Permesso";
            let residuoRilevatoStr = "";
            let residuoNum = 0;
            if (worker) {
                if (tipoAssenza === "Ferie") {
                    residuoNum = worker.ferieResidue || 0;
                    residuoRilevatoStr = `${residuoNum} ore`;
                } else if (tipoAssenza === "Permesso") {
                    residuoNum = worker.permessiResidui || 0;
                    residuoRilevatoStr = `${residuoNum} ore`;
                } else {
                    residuoNum = worker.altreResidue || 0;
                    residuoRilevatoStr = `${residuoNum} ore`;
                }
            }

            const residuePreviewEl = document.getElementById('elb-worker-residue-preview');
            if (residuePreviewEl) {
                const reqHours = parseFloat(req.hoursNum) || 0;
                const remaining = residuoNum - reqHours;
                residuePreviewEl.innerText = `Saldo attuale: ${residuoRilevatoStr} (Post approvazione: ${remaining}h)`;
            }

            // 7. Cantiere & Reparto
            const cantiereEl = document.getElementById('elb-cantiere');
            if (cantiereEl) {
                const cantiereName = req.cantiere || (worker ? worker.cantiere : "") || "Sede Principale / Stabilimento";
                cantiereEl.innerText = cantiereName;
                cantiereEl.title = cantiereName;
            }
            const deptEl = document.getElementById('elb-worker-dept');
            if (deptEl) {
                deptEl.innerText = worker ? `Reparto: ${worker.department || 'Produzione'} • ${worker.category || 'Operaio'}` : "Produzione";
            }

            // 8. Motivo dell'Assenza
            const reasonEl = document.getElementById('elb-reason');
            if (reasonEl) {
                reasonEl.innerText = req.reason ? `"${req.reason}"` : "Nessuna motivazione specifica indicata.";
            }

            // 9. Firma del Dipendente
            const sigEl = document.getElementById('elb-worker-signature');
            if (sigEl) {
                sigEl.innerText = req.workerSignature || `${fullName} (Firma Digitale)`;
                sigEl.title = req.workerSignature || "";
            }

            // 10. Precompilazione Campi Firme DTC, RAM, A.U.
            if (req.techEsigenza) {
                const radios = document.getElementsByName('elb-tech-esigenza');
                radios.forEach(r => {
                    if (r.value === req.techEsigenza) r.checked = true;
                });
            }
            if (req.techFirma) {
                document.getElementById('elb-tech-firma').value = req.techFirma;
            } else {
                document.getElementById('elb-tech-firma').value = "roberto petrone";
            }

            if (req.adminResidui) {
                document.getElementById('elb-admin-residui').value = req.adminResidui;
            } else {
                document.getElementById('elb-admin-residui').value = residuoRilevatoStr;
            }

            if (req.adminFirmaRAM) {
                document.getElementById('elb-admin-ram').value = req.adminFirmaRAM;
            } else {
                document.getElementById('elb-admin-ram').value = "A. Vi.Cla.";
            }

            if (req.adminFirmaAU) {
                document.getElementById('elb-admin-au').value = req.adminFirmaAU;
            } else {
                document.getElementById('elb-admin-au').value = "Vi.Cla. Amm.";
            }

            document.getElementById('request-elaborate-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function saveAndApproveRequest(newStatus) {
            if (!selectedRequestIdForElaboration) return;
            const reqIndex = leaveRequests.findIndex(r => r.id === selectedRequestIdForElaboration);
            if (reqIndex === -1) return;

            const req = leaveRequests[reqIndex];

            const techEsigenzaRadios = document.getElementsByName('elb-tech-esigenza');
            let selectedEsigenza = "LIEVE";
            techEsigenzaRadios.forEach(r => {
                if (r.checked) selectedEsigenza = r.value;
            });

            const techFirmaVal = document.getElementById('elb-tech-firma').value.trim();
            const adminResiduiVal = document.getElementById('elb-admin-residui').value.trim();
            const adminFirmaRAMVal = document.getElementById('elb-admin-ram').value.trim();
            const adminFirmaAUVal = document.getElementById('elb-admin-au').value.trim();

            if (newStatus === 'Approvata') {
                if (!techFirmaVal) {
                    showToast("Impossibile approvare: manca la firma del DTC (Ufficio Tecnico)!", "error");
                    return;
                }
                if (!adminResiduiVal) {
                    showToast("Impossibile approvare: inserire il calcolo dei permessi residui!", "error");
                    return;
                }
                if (!adminFirmaRAMVal) {
                    showToast("Impossibile approvare: manca la firma del RAM (Amministrazione)!", "error");
                    return;
                }
                if (!adminFirmaAUVal) {
                    showToast("Impossibile approvare: manca la firma dell'Amministratore Unico (A.U.)!", "error");
                    return;
                }

                const workerIndex = workers.findIndex(w => w.id === req.workerId);
                if (workerIndex !== -1) {
                    const oreRichieste = parseFloat(req.hoursNum) || 0;
                    const tipoAssenza = req.leaveType || "Permesso";

                    if (tipoAssenza === 'Ferie') {
                        workers[workerIndex].ferieResidue = Math.max(0, (workers[workerIndex].ferieResidue || 0) - oreRichieste);
                    } else if (tipoAssenza === 'Permesso') {
                        workers[workerIndex].permessiResidui = Math.max(0, (workers[workerIndex].permessiResidui || 0) - oreRichieste);
                    } else {
                        workers[workerIndex].altreResidue = Math.max(0, (workers[workerIndex].altreResidue || 0) - oreRichieste);
                    }

                    localStorage.setItem('vicla_workers', JSON.stringify(workers));
                    showToast(`Sottratte ${oreRichieste} ore di ${tipoAssenza} dal saldo!`, "info");
                }
            }

            req.status = newStatus;
            req.techEsigenza = selectedEsigenza;
            req.techFirma = techFirmaVal;
            req.techDate = new Date().toISOString().split('T')[0];
            req.adminResidui = adminResiduiVal;
            req.adminFirmaRAM = adminFirmaRAMVal;
            req.adminFirmaAU = adminFirmaAUVal;

            localStorage.setItem('vicla_leave_requests', JSON.stringify(leaveRequests));
            showToast("Richiesta registrata con successo!", "success");

            // Trigger Notifica Push PWA al dipendente
            const outcomeText = newStatus === 'Approvata' ? 'Approvata ✅' : 'Rifiutata ❌';
            (window.addNotification || addNotification)({
                workerId: req.workerId,
                title: `Richiesta ${req.leaveType || 'Permesso'} ${outcomeText}`,
                message: `La tua richiesta di ${req.leaveType ? req.leaveType.toLowerCase() : 'permesso'} del ${req.datePermesso || req.dateRequested} è stata ${newStatus.toLowerCase()} dalla Direzione.`,
                type: "leave",
                targetTab: "leave"
            });

            document.getElementById('request-elaborate-card').classList.add('hidden');
            selectedRequestIdForElaboration = null;

            renderAdminRequestsTab();
            renderAdminDashboard();
        }
    </script>

    <script>
        function updateNoticeFileLabel() {
            const input = document.getElementById('notice-file-input');
            const textZone = document.getElementById('notice-file-zone-text');
            if (input.files.length > 0) {
                textZone.innerHTML = `
                    <i class="fa-solid fa-file-pdf text-lg text-emerald-600"></i>
                    <p class="text-xs text-emerald-600 font-bold">${input.files[0].name}</p>
                `;
