<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vi.Cla. Future S.r.l. - Portale Comunicazioni, Buste Paga e Richieste</title>

    <!-- Metadati PWA e Installabilità Mobile -->
    <link rel="manifest" href="./manifest.webmanifest">
    <meta name="theme-color" content="#0f2b5c">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Vi.Cla. Portale">
    <link rel="apple-touch-icon" href="./icons/icon.svg">
    <link rel="icon" type="image/svg+xml" href="./icons/icon.svg">

    <!-- Tailwind CSS con dark mode manuale (disaccoppiato dal tema OS per preservare la visione Giorno e Notte) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        };
        // Inizializzazione immediata anti-flicker
        if (localStorage.getItem('vicla_dark_mode') === 'true') {
            document.documentElement.classList.add('dark-mode', 'dark');
        } else {
            document.documentElement.classList.remove('dark-mode', 'dark');
        }
    </script>
    <!-- Google Fonts (Outfit per titoli & Plus Jakarta Sans / Inter per leggibilità) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <!-- FontAwesome per icone professionali ad alta risoluzione -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Librerie per il trattamento dei PDF caricate con defer per non bloccare il rendering iniziale -->
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>

    <style>
        :root {
            --font-heading: 'Outfit', -apple-system, sans-serif;
            --font-body: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
            --vicla-blue: #0f2b5c;
            --vicla-blue-dark: #071736;
            --vicla-orange: #f37021;
            --vicla-orange-hover: #e05e10;
        }

        body {
            font-family: var(--font-body);
            background: radial-gradient(at 0% 0%, rgba(15, 43, 92, 0.05) 0px, transparent 50%),
                        radial-gradient(at 100% 100%, rgba(243, 112, 33, 0.05) 0px, transparent 50%),
                        #f8fafc;
            color: #0f172a;
            transition: background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease;
        }

        h1, h2, h3, h4, h5, h6, .font-heading {
            font-family: var(--font-heading);
            letter-spacing: -0.025em;
        }

        /* Palette colori ufficiale Vi.Cla. Future S.r.l. */
        .color-vicla-blue { color: #0f2b5c; }
        .bg-vicla-blue { background-color: #0f2b5c; }
        .border-vicla-blue { border-color: #0f2b5c; }
        .bg-vicla-orange { background-color: #f37021; }
        .color-vicla-orange { color: #f37021; }
        .hover-bg-vicla-blue:hover { background-color: #0c224a; }
        .focus-ring-vicla:focus { --tw-ring-color: #f37021; }

        /* Effetti Glassmorphism e Card Elevate */
        .glass-header {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.85);
            transition: all 0.3s ease;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04), 0 2px 6px -1px rgba(15, 23, 42, 0.02);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-card:hover {
            border-color: rgba(15, 43, 92, 0.2);
        }

        .card-interactive {
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .card-interactive:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px -4px rgba(15, 43, 92, 0.08), 0 4px 8px -2px rgba(15, 43, 92, 0.03);
        }

        .glow-orange {
            box-shadow: 0 4px 18px rgba(243, 112, 33, 0.25);
        }

        .glow-blue {
            box-shadow: 0 4px 18px rgba(15, 43, 92, 0.2);
        }

        /* Animazione Ultra Fluida & Armoniosa di Ingrandimento e Impicciolimento (Senza Scatti) */
        @keyframes kpiIconPulseZoom {
            0%, 100% {
                transform: scale(1);
            }
            35% {
                transform: scale(0.93);
            }
            70% {
                transform: scale(1.09);
            }
        }

        .kpi-pulse-icon {
            transform-origin: center center;
            will-change: transform;
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .group:hover .kpi-pulse-icon {
            animation: kpiIconPulseZoom 2.8s ease-in-out infinite;
        }

        /* Scrollbar rifinita */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        html.dark ::-webkit-scrollbar-track,
        html.dark-mode ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        html.dark ::-webkit-scrollbar-thumb,
        html.dark-mode ::-webkit-scrollbar-thumb {
            background: #334155;
        }
        html.dark ::-webkit-scrollbar-thumb:hover,
        html.dark-mode ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        /* Scorrimento interno tabella anagrafica */
        #admin-workers-table-container {
            scrollbar-gutter: stable;
        }
        #admin-workers-table-container::-webkit-scrollbar {
            width: 7px;
            height: 7px;
        }
        #admin-workers-table-container::-webkit-scrollbar-track {
            background: rgba(148, 163, 184, 0.08);
            border-radius: 8px;
        }
        #admin-workers-table-container::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.35);
            border-radius: 8px;
        }
        #admin-workers-table-container::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, 0.6);
        }
        html.dark #admin-workers-table-container::-webkit-scrollbar-thumb,
        html.dark-mode #admin-workers-table-container::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.25);
        }
        html.dark #admin-workers-table-container::-webkit-scrollbar-thumb:hover,
        html.dark-mode #admin-workers-table-container::-webkit-scrollbar-thumb:hover {
            background: rgba(243, 112, 33, 0.6);
        }

        /* Regole di stampa rigorose per il Modulo Ufficiale SGQ MD6 */
        @media print {
            body {
                background-color: white !important;
                color: black !important;
            }
            body * {
                visibility: hidden;
            }
            #print-area-sgq,
            #print-area-sgq * {
                visibility: visible;
            }
            #print-area-sgq {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background-color: white !important;
                color: black !important;
                font-family: 'Courier New', Courier, monospace;
            }
            .no-print {
                display: none !important;
            }
            @page {
                size: A4;
                margin: 1.5cm;
            }
        }

        /* --- VERO DARK MODE A TOKEN CSS (Nessun filtro invert) --- */
        html.dark-mode {
            color-scheme: dark;
        }

        html.dark-mode body,
        html.dark body {
            background: radial-gradient(at 0% 0%, rgba(15, 43, 92, 0.45) 0px, transparent 60%),
                        radial-gradient(at 100% 100%, rgba(243, 112, 33, 0.15) 0px, transparent 60%),
                        #070b14 !important;
            color: #f1f5f9 !important;
        }

        html.dark-mode .glass-header {
            background: rgba(9, 14, 28, 0.88) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        }

        html.dark-mode .glass-card,
        html.dark-mode .bg-white {
            background-color: rgba(15, 23, 42, 0.88) !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
            color: #f1f5f9 !important;
        }

        html.dark-mode .bg-slate-50 {
            background-color: rgba(10, 15, 28, 0.7) !important;
        }

        html.dark-mode .bg-slate-100 {
            background-color: rgba(30, 41, 59, 0.75) !important;
            color: #cbd5e1 !important;
        }

        html.dark-mode .bg-slate-200 {
            background-color: rgba(51, 65, 85, 0.75) !important;
        }

        html.dark-mode .border-slate-100,
        html.dark-mode .border-slate-200,
        html.dark-mode .border-slate-300 {
            border-color: rgba(255, 255, 255, 0.08) !important;
        }

        html.dark-mode .text-slate-800,
        html.dark-mode .text-slate-700,
        html.dark-mode .text-slate-900 {
            color: #f8fafc !important;
        }

        html.dark-mode .text-slate-600,
        html.dark-mode .text-slate-500 {
            color: #94a3b8 !important;
        }

        html.dark-mode .text-slate-400 {
            color: #64748b !important;
        }

        html.dark-mode input,
        html.dark-mode select,
        html.dark-mode textarea {
            background-color: #0f172a !important;
            color: #f8fafc !important;
            border-color: #334155 !important;
        }

        html.dark-mode input:focus,
        html.dark-mode select:focus,
        html.dark-mode textarea:focus {
            border-color: #f37021 !important;
            box-shadow: 0 0 0 2px rgba(243, 112, 33, 0.25) !important;
        }

        html.dark-mode tr:hover {
            background-color: rgba(30, 41, 59, 0.4) !important;
        }

        html.dark-mode thead {
            background-color: #0c1427 !important;
            color: #94a3b8 !important;
        }

        /* Intestazione tabella lavoratori: 100% solida e opaca sia Giorno che Notte per evitare trasparenze */
        #admin-workers-table-container thead th {
            position: sticky !important;
            top: 0 !important;
            z-index: 30 !important;
            background-color: #f1f5f9 !important; /* Grigio chiaro 100% coprente in Giorno */
            color: #475569 !important;
            border-bottom: 2px solid #cbd5e1 !important;
        }

        html.dark-mode #admin-workers-table-container thead th,
        html.dark #admin-workers-table-container thead th {
            background-color: #0c1427 !important; /* Blu navy 100% coprente in Notte */
            color: #94a3b8 !important;
            border-bottom: 2px solid #334155 !important;
        }

        html.dark-mode ::-webkit-scrollbar-track {
            background: #090d16;
        }

        html.dark-mode ::-webkit-scrollbar-thumb {
            background: #334155;
        }

        /* --- EFFETTO FLUIDO AURORA MESH (Personalizzato con colori e movimenti unici per ogni Ruolo di Login) --- */
        #aurora-ambient-container {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
            transition: opacity 0.4s ease;
        }

        #aurora-ambient-container.aurora-hidden {
            display: none !important;
        }

        .aurora-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(95px);
            opacity: 0.22;
            will-change: transform;
            transition: background 0.6s ease, opacity 0.5s ease, filter 0.5s ease;
        }

        html.dark-mode .aurora-orb,
        html.dark .aurora-orb {
            opacity: 0.58;
            filter: blur(110px);
        }

        /* ---------------------------------------------------------
           TEMA 1: RESPONSABILE (HR / ADMIN) - AURORA MESH AZIENDALE
           Blu Elettrico + Arancione Vi.Cla. + Viola Magnetico
           Movimento: Orbite multiassiali planetarie
           --------------------------------------------------------- */
        .aurora-theme-admin .aurora-orb-1 {
            width: 58vw; height: 58vw; max-width: 760px; max-height: 760px;
            top: -15%; left: -10%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.95) 0%, rgba(15, 43, 92, 0.8) 45%, transparent 75%);
            animation: aurora-admin-1 5.5s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
        }
        .aurora-theme-admin .aurora-orb-2 {
            width: 52vw; height: 52vw; max-width: 700px; max-height: 700px;
            top: -10%; right: -10%;
            background: radial-gradient(circle, rgba(249, 115, 22, 0.95) 0%, rgba(243, 112, 33, 0.75) 45%, transparent 75%);
            animation: aurora-admin-2 6.2s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
        }
        .aurora-theme-admin .aurora-orb-3 {
            width: 48vw; height: 48vw; max-width: 640px; max-height: 640px;
            top: 18%; left: 28%;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.9) 0%, rgba(192, 38, 211, 0.7) 45%, transparent 75%);
            animation: aurora-admin-3 4.8s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
        }
        .aurora-theme-admin .aurora-orb-4 {
            width: 44vw; height: 44vw; max-width: 580px; max-height: 580px;
            bottom: -15%; right: 12%;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.9) 0%, rgba(217, 119, 6, 0.65) 45%, transparent 75%);
            animation: aurora-admin-4 5.8s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
        }

        /* ---------------------------------------------------------
           TEMA 2: OPERAIO (CANTIERE & PRODUZIONE) - EMBER FLAME MESH
           Arancione Fiamma + Oro Fuso + Rosso Rubino Caldo
           Movimento: Ondata termica ascendente e pulsazione calorica
           --------------------------------------------------------- */
        .aurora-theme-operaio .aurora-orb-1 {
            width: 55vw; height: 55vw; max-width: 720px; max-height: 720px;
            bottom: -10%; left: -5%;
            background: radial-gradient(circle, rgba(234, 88, 12, 0.95) 0%, rgba(194, 65, 12, 0.8) 45%, transparent 75%);
            animation: operaio-ember-1 4.5s cubic-bezier(0.25, 1, 0.5, 1) infinite alternate;
        }
        .aurora-theme-operaio .aurora-orb-2 {
            width: 58vw; height: 58vw; max-width: 760px; max-height: 760px;
            top: -15%; right: -5%;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.95) 0%, rgba(217, 119, 6, 0.75) 45%, transparent 75%);
            animation: operaio-ember-2 5.2s cubic-bezier(0.3, 0, 0.2, 1) infinite alternate;
        }
        .aurora-theme-operaio .aurora-orb-3 {
            width: 50vw; height: 50vw; max-width: 660px; max-height: 660px;
            top: 25%; left: 35%;
            background: radial-gradient(circle, rgba(225, 29, 72, 0.9) 0%, rgba(190, 18, 60, 0.7) 45%, transparent 75%);
            animation: operaio-ember-3 4.2s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
        }
        .aurora-theme-operaio .aurora-orb-4 {
            width: 46vw; height: 46vw; max-width: 600px; max-height: 600px;
            bottom: -5%; right: 25%;
            background: radial-gradient(circle, rgba(251, 191, 36, 0.95) 0%, rgba(217, 119, 6, 0.7) 45%, transparent 75%);
            animation: operaio-ember-4 4.8s cubic-bezier(0.2, 0.8, 0.4, 1) infinite alternate;
        }

        /* ---------------------------------------------------------
           TEMA 3: DIPENDENTE (UFFICIO TECNICO) - CYBER OCEANIC WAVE
           Ciano Elettrico + Smeraldo High-Tech + Deep Blue
           Movimento: Onde sinusoidali orizzontali ad ampiezza variabile
           --------------------------------------------------------- */
        .aurora-theme-dipendente .aurora-orb-1 {
            width: 56vw; height: 56vw; max-width: 740px; max-height: 740px;
            top: -10%; left: -8%;
            background: radial-gradient(circle, rgba(6, 182, 212, 0.95) 0%, rgba(14, 116, 144, 0.8) 45%, transparent 75%);
            animation: dipendente-cyber-1 5.8s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
        }
        .aurora-theme-dipendente .aurora-orb-2 {
            width: 52vw; height: 52vw; max-width: 680px; max-height: 680px;
            bottom: -15%; right: -5%;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.95) 0%, rgba(4, 120, 87, 0.75) 45%, transparent 75%);
            animation: dipendente-cyber-2 6.4s cubic-bezier(0.35, 0, 0.25, 1) infinite alternate;
        }
        .aurora-theme-dipendente .aurora-orb-3 {
            width: 50vw; height: 50vw; max-width: 650px; max-height: 650px;
            top: 20%; right: 28%;
            background: radial-gradient(circle, rgba(14, 165, 233, 0.9) 0%, rgba(3, 105, 161, 0.7) 45%, transparent 75%);
            animation: dipendente-cyber-3 5.0s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
        }
        .aurora-theme-dipendente .aurora-orb-4 {
            width: 48vw; height: 48vw; max-width: 620px; max-height: 620px;
            bottom: 10%; left: 18%;
            background: radial-gradient(circle, rgba(45, 212, 191, 0.9) 0%, rgba(13, 148, 136, 0.65) 45%, transparent 75%);
            animation: dipendente-cyber-4 5.4s cubic-bezier(0.45, 0, 0.3, 1) infinite alternate;
        }

        /* Keyframes Responsabile (Rotazioni & orbite multiassiali) */
        @keyframes aurora-admin-1 {
            0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
            33% { transform: translate3d(14vw, 18vh, 0) scale(1.15) rotate(15deg); }
            66% { transform: translate3d(-10vw, 24vh, 0) scale(0.9) rotate(-10deg); }
            100% { transform: translate3d(8vw, 12vh, 0) scale(1.08) rotate(20deg); }
        }
        @keyframes aurora-admin-2 {
            0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
            33% { transform: translate3d(-16vw, 16vh, 0) scale(1.18) rotate(-15deg); }
            66% { transform: translate3d(8vw, 26vh, 0) scale(0.88) rotate(12deg); }
            100% { transform: translate3d(-8vw, 10vh, 0) scale(1.12) rotate(-8deg); }
        }
        @keyframes aurora-admin-3 {
            0% { transform: translate3d(0, 0, 0) scale(0.95) rotate(0deg); }
            33% { transform: translate3d(-18vw, -12vh, 0) scale(1.22) rotate(25deg); }
            66% { transform: translate3d(14vw, 14vh, 0) scale(1.08) rotate(-18deg); }
            100% { transform: translate3d(-6vw, 18vh, 0) scale(1.14) rotate(10deg); }
        }
        @keyframes aurora-admin-4 {
            0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
            33% { transform: translate3d(16vw, -16vh, 0) scale(1.15) rotate(-20deg); }
            66% { transform: translate3d(-14vw, -20vh, 0) scale(0.92) rotate(15deg); }
            100% { transform: translate3d(10vw, -8vh, 0) scale(1.1) rotate(-10deg); }
        }

        /* Keyframes Operaio (Ondate termiche ascendenti & pulsazione calorica viva) */
        @keyframes operaio-ember-1 {
            0% { transform: translate3d(0, 0, 0) scale(1); }
            50% { transform: translate3d(18vw, -22vh, 0) scale(1.24); }
            100% { transform: translate3d(-8vw, -36vh, 0) scale(0.95); }
        }
        @keyframes operaio-ember-2 {
            0% { transform: translate3d(0, 0, 0) scale(1.05); }
            50% { transform: translate3d(-20vw, 20vh, 0) scale(0.88); }
            100% { transform: translate3d(-10vw, 32vh, 0) scale(1.2); }
        }
        @keyframes operaio-ember-3 {
            0% { transform: translate3d(0, 0, 0) scale(0.9); }
            50% { transform: translate3d(12vw, -18vh, 0) scale(1.3); }
            100% { transform: translate3d(-14vw, 14vh, 0) scale(1.05); }
        }
        @keyframes operaio-ember-4 {
            0% { transform: translate3d(0, 0, 0) scale(1.1); }
            50% { transform: translate3d(-24vw, -25vh, 0) scale(1.25); }
            100% { transform: translate3d(15vw, -12vh, 0) scale(0.9); }
        }

        /* Keyframes Dipendente (Onde orizzontali sinusoidali tech & espansioni) */
        @keyframes dipendente-cyber-1 {
            0% { transform: translate3d(0, 0, 0) scale(1); }
            35% { transform: translate3d(24vw, 8vh, 0) scale(1.18); }
            70% { transform: translate3d(12vw, -14vh, 0) scale(0.92); }
            100% { transform: translate3d(28vw, 2vh, 0) scale(1.1); }
        }
        @keyframes dipendente-cyber-2 {
            0% { transform: translate3d(0, 0, 0) scale(1); }
            35% { transform: translate3d(-26vw, -10vh, 0) scale(1.2); }
            70% { transform: translate3d(-14vw, 16vh, 0) scale(0.85); }
            100% { transform: translate3d(-30vw, 4vh, 0) scale(1.12); }
        }
        @keyframes dipendente-cyber-3 {
            0% { transform: translate3d(0, 0, 0) scale(0.95); }
            50% { transform: translate3d(-18vw, 18vh, 0) scale(1.22); }
            100% { transform: translate3d(16vw, -20vh, 0) scale(1.05); }
        }
        @keyframes dipendente-cyber-4 {
            0% { transform: translate3d(0, 0, 0) scale(1.08); }
            50% { transform: translate3d(22vw, -16vh, 0) scale(0.9); }
            100% { transform: translate3d(-12vw, 20vh, 0) scale(1.2); }
        }

        /* ---------------------------------------------------------
           TEMA 4: DASHBOARD & SEZIONI ATTIVE - SFUMATURE LATERALI SOFT
           Movimento delicato e rilassante ai bordi/laterali dello schermo
           Risolve il contrasto del "troppo bianco" in visione Giorno
           --------------------------------------------------------- */
        .aurora-lateral-dashboard .aurora-orb-1 {
            width: 44vw; height: 44vw; max-width: 640px; max-height: 640px;
            top: 2vh; left: -15vw;
            background: radial-gradient(circle, rgba(15, 43, 92, 0.22) 0%, rgba(56, 189, 248, 0.18) 40%, rgba(99, 102, 241, 0.08) 65%, transparent 75%);
            animation: lateral-soft-left-1 18s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
            filter: blur(85px);
            opacity: 0.85;
        }
