                } else if (fault.status === 'In Riparazione') {
                    statusBadge = `<span class="px-2.5 py-1 bg-amber-500 text-white font-black rounded-lg text-xs shadow-xs inline-flex items-center gap-1 whitespace-nowrap shrink-0"><i class="fa-solid fa-wrench"></i> IN RIPARAZIONE</span>`;
                } else {
                    statusBadge = `<span class="px-2.5 py-1 bg-rose-500 text-white font-black rounded-lg text-xs shadow-xs inline-flex items-center gap-1 whitespace-nowrap shrink-0"><i class="fa-solid fa-circle-dot"></i> APERTA</span>`;
