            const notice = notices.find(n => n.id === currentSelectedNoticeId);
            if (!notice) return;

            let sentCount = 0;
            workers.forEach(w => {
                const hasRead = notice.reads && notice.reads[w.id];
                if (!hasRead) {
                    sentCount++;
                    notifications.unshift({
                        id: "REMIND_N_" + Date.now() + "_" + Math.floor(Math.random() * 1000),
                        workerId: w.id,
                        title: `Promemoria: Firma "${notice.title}"`,
                        message: `È richiesta la tua presa visione e firma per la comunicazione "${notice.title}".`,
                        type: "notice",
                        targetTab: "notices",
                        date: new Date().toISOString(),
                        read: false
                    });
                }
            });

            if (sentCount === 0) {
                showToast("Tutti i dipendenti hanno già firmato questo comunicato!", "success");
                return;
            }

            if (notifications.length > 60) notifications = notifications.slice(0, 60);
            localStorage.setItem('vicla_notifications', JSON.stringify(notifications));

            dispatchBrowserPushNotification(`Promemoria: ${notice.title}`, `Sollecito inviato a ${sentCount} dipendenti.`);
            renderNotificationsDrawer();
            showToast(`🔔 Promemoria inviato con successo a ${sentCount} lavoratori mancanti!`, "success");
