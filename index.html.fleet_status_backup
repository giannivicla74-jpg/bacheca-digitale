        function handleNotificationClick(notifId) {
            const notif = notifications.find(n => n.id === notifId);
            if (notif) {
                notif.read = true;
                localStorage.setItem('vicla_notifications', JSON.stringify(notifications));
                renderNotificationsDrawer();

                // Navigazione intelligente
                if (notif.targetTab) {
                    if (currentRole === 'operaio' || currentRole === 'dipendente') {
                        if (notif.targetTab === 'payslips') switchWorkerTab('payslips');
                        else if (notif.targetTab === 'leave') switchWorkerTab('leave');
                        else switchWorkerTab('notices');
                    } else if (currentRole === 'admin') {
                        if (notif.targetTab === 'payslips') switchAdminTab('payslips');
                        else if (notif.targetTab === 'leave' || notif.targetTab === 'requests') switchAdminTab('requests');
                        else switchAdminTab('notices');
                    }
                }
            }
            const drawer = document.getElementById('notification-drawer');
            if (drawer) drawer.classList.add('hidden');
        }

