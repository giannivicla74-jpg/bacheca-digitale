            if (type === 'permessi') workers[index].permessiResidui = valNum;
            if (type === 'altre') workers[index].altreResidue = valNum;

            localStorage.setItem('vicla_workers', JSON.stringify(workers));
            showToast("Saldo ore aggiornato con successo!", "success");

            if (selectedWorkerId === workerId) {
