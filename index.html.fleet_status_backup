        function toggleTableScrollLock() {
            const container = document.getElementById('admin-workers-table-container');
            const currentlyLocked = container && container.style.maxHeight !== '';
            const newState = !currentlyLocked;
            localStorage.setItem('vicla_table_scroll_lock', newState ? 'true' : 'false');
            applyTableScrollLock(newState);

            // Scorrimento fluido: posiziona la card esattamente sotto l'header sticky
            if (newState) {
                if (container) {
                    container.scrollTop = 0;
                }
                const card = document.getElementById('anagrafica-personale-card');
                const stickyHeader = document.querySelector('header.glass-header');
                if (card) {
                    const headerHeight = stickyHeader ? stickyHeader.offsetHeight : 0;
                    const cardTop = card.getBoundingClientRect().top + window.pageYOffset;
                    const targetY = cardTop - headerHeight - 8; // 8px di margine respirazione
                    window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
                }
            }
        }

        function applyTableScrollLock(isLocked) {
            const container = document.getElementById('admin-workers-table-container');
            const btn = document.getElementById('btn-toggle-table-lock');
            const icon = document.getElementById('icon-table-lock');
            const label = document.getElementById('label-table-lock');
            const thead = document.getElementById('admin-workers-thead');

            if (!container) return;

            if (isLocked) {
                // Calcola altezza disponibile in base al viewport
                const availableH = Math.max(340, window.innerHeight - 260);
                container.style.maxHeight = availableH + 'px';
                container.style.overflowY = 'auto';
                container.style.overflowX = 'hidden';
                container.style.overscrollBehavior = 'contain';

                if (thead) {
                    thead.style.position = 'sticky';
                    thead.style.top = '0';
                    thead.style.zIndex = '20';
                }

                if (btn) {
                    btn.className = "text-xs px-3.5 py-2.5 bg-amber-500/20 hover:bg-amber-500/30 text-amber-700 dark:text-amber-300 border border-amber-500/40 rounded-xl font-bold flex items-center gap-2 transition-all shadow-md active:scale-95 ring-2 ring-amber-500/30 cursor-pointer select-none";
                    if (icon) icon.className = "fa-solid fa-lock text-amber-500";
                    if (label) label.innerText = "Blocco Tabella: ATTIVO";
                    btn.setAttribute('title', "La tabella scorre internamente con intestazione fissa. Clicca per sbloccare.");
                }
            } else {
                // Rimuovi vincoli — la tabella torna a piena altezza
                container.style.maxHeight = '';
                container.style.overflowY = '';
                container.style.overflowX = 'hidden';
                container.style.overscrollBehavior = '';

                if (thead) {
                    thead.style.position = '';
                    thead.style.top = '';
                    thead.style.zIndex = '';
                }

                if (btn) {
                    btn.className = "text-xs px-3.5 py-2.5 bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700/80 text-slate-600 dark:text-slate-400 border border-slate-200/80 dark:border-slate-700/80 rounded-xl font-bold flex items-center gap-2 transition-all shadow-xs hover:scale-105 active:scale-95 cursor-pointer select-none";
                    if (icon) icon.className = "fa-solid fa-lock-open text-slate-400";
                    if (label) label.innerText = "Blocca Tabella";
                    btn.setAttribute('title', "Clicca per fissare l'intestazione e scorrere solo le righe della tabella.");
                }
            }
        }

        // Ricalcola altezza contenitore al ridimensionamento finestra
        window.addEventListener('resize', function() {
            const container = document.getElementById('admin-workers-table-container');
            if (container && container.style.maxHeight !== '') {
                const availableH = Math.max(340, window.innerHeight - 260);
                container.style.maxHeight = availableH + 'px';
            }
        });

        // CALCOLO E RENDERING BAR CHART DI REPARTO (NOVITÀ v2.2.1)
        function renderDepartmentAnalytics() {
            const container = document.getElementById('department-analytics-container');
            if (!container) return;
            container.innerHTML = '';

            // Calcolo ore totali per reparto
            const deptTotals = {};
            let maxTotal = 0;

            workers.forEach(w => {
                const dept = w.department || "N/D";
                const totalHours = (parseFloat(w.ferieResidue) || 0) + (parseFloat(w.permessiResidui) || 0) + (parseFloat(w.altreResidue) || 0);

                if (!deptTotals[dept]) deptTotals[dept] = 0;
                deptTotals[dept] += totalHours;
            });

            // Trova il picco per normalizzare la percentuale
            Object.values(deptTotals).forEach(v => {
                if (v > maxTotal) maxTotal = v;
            });

            // Generazione barre orizzontali comparative
            Object.keys(deptTotals).sort((a, b) => deptTotals[b] - deptTotals[a]).forEach(dept => {
                const hours = deptTotals[dept];
                const percentage = maxTotal > 0 ? Math.round((hours / maxTotal) * 100) : 0;

                const item = document.createElement('div');
                item.className = "space-y-1";
                item.innerHTML = `
                    <div class="flex justify-between text-xs font-semibold">
                        <span class="text-slate-700">${dept}</span>
                        <span class="text-blue-950 font-mono font-bold">${hours} ore totali</span>
                    </div>
                    <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
                        <div class="bg-blue-900 h-full rounded-full transition-all duration-500" style="width: ${percentage}%"></div>
                    </div>
                `;
                container.appendChild(item);
            });
        }
    </script>

    <script>
        function populatePayslipWorkerDropdown() {
