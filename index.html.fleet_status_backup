        function handleCreateNotice(event) {
            event.preventDefault();

            const title = document.getElementById('input-title').value.trim();
            const category = document.getElementById('input-category').value;
            const priority = document.getElementById('input-priority').value;
            const department = document.getElementById('input-department').value;
            const content = document.getElementById('input-content').value.trim();
            const fileInput = document.getElementById('notice-file-input');

            const hasAttachment = fileInput.files.length > 0;
            const attachmentName = hasAttachment ? fileInput.files[0].name : "";

            const noticeId = "N" + String(notices.length + 1).padStart(2, '0');

            const newNotice = {
                id: noticeId,
                title: title,
                category: category,
                priority: priority,
                department: department,
                content: content,
                date: new Date().toISOString(),
                reads: {},
                hasAttachment: hasAttachment,
                attachmentName: attachmentName
            };

            const finalizeNoticeSave = () => {
                notices.push(newNotice);
                localStorage.setItem('vicla_notices', JSON.stringify(notices));
                document.getElementById('form-notice').reset();
                document.getElementById('notice-file-zone-text').innerHTML = `
                    <i class="fa-solid fa-cloud-arrow-up text-lg text-slate-400"></i>
                    <p class="text-xs text-slate-500 font-medium">Trascina o clicca per allegare</p>
                `;
                showToast("Comunicazione pubblicata con successo!", "success");
                currentSelectedNoticeId = newNotice.id;
                renderAdminDashboard();

                // Trigger Notifica Push PWA a tutti i dipendenti
                addNotification({
                    workerId: "ALL",
                    title: `Nuova Comunicazione: ${title}`,
                    message: content.length > 90 ? content.substring(0, 90) + "..." : content,
                    type: "notice",
                    targetTab: "notices"
                });
            };

            if (hasAttachment) {
                const file = fileInput.files[0];
                saveFileToDB("notice_" + noticeId, file, finalizeNoticeSave);
            } else {
                finalizeNoticeSave();
            }
        }

        async function handleUploadPayslip(event) {
            event.preventDefault();

            const workerId = document.getElementById('payslip-worker').value;
            const month = document.getElementById('payslip-month').value;
            const year = document.getElementById('payslip-year').value;
            const netValRaw = document.getElementById('payslip-net').value.replace(',', '.');
            const netAmountVal = parseFloat(netValRaw) || 0;
            const fileInput = document.getElementById('payslip-pdf-input');

            if (fileInput.files.length === 0) {
                showToast("Seleziona il PDF prima di pubblicare!", "warning");
                return;
            }

            const file = fileInput.files[0];

            // ==========================================
            // LOGICA MULTI-PAYSLIP
            // ==========================================
            if (workerId === "ALL") {
                if (!window.parseMultiPayslipPDF) {
                    showToast("Modulo PDF non caricato ancora.", "error");
                    return;
                }

                showToast("Lettura PDF in corso, attendere...", "info");

                try {
                    const parseResult = await window.parseMultiPayslipPDF(file, workers);
                    window.currentMultiPayslipResult = parseResult;

                    // Mostra modale
                    const tbody = document.getElementById('multi-payslip-table-body');
                    tbody.innerHTML = '';

                    parseResult.assignments.forEach((assignment, index) => {
                        const tr = document.createElement('tr');

                        // Select operai
                        let selectHtml = `<select onchange="updateMultiAssignment(${index}, this.value)" class="w-full text-xs px-2 py-1 rounded border border-slate-200">
                            <option value="">-- Assegna Manualmente --</option>`;
                        workers.forEach(w => {
                            const selected = w.id === assignment.workerId ? 'selected' : '';
                            selectHtml += `<option value="${w.id}" ${selected}>${w.name} ${w.surname}</option>`;
                        });
                        selectHtml += `</select>`;

                        tr.innerHTML = `
                            <td class="px-4 py-3 font-medium">${assignment.pageNumber}</td>
                            <td class="px-4 py-3 text-xs text-slate-500 font-mono overflow-hidden whitespace-nowrap max-w-[200px]" title="${assignment.extractedTextSnippet}">
                                ${assignment.extractedTextSnippet}
                            </td>
                            <td class="px-4 py-3">
                                ${selectHtml}
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });

                    document.getElementById('multi-payslip-modal').classList.remove('hidden');

                    // Configura tasto conferma
                    const confirmBtn = document.getElementById('confirm-multi-payslip-btn');
                    confirmBtn.onclick = () => executeMultiPayslip(month, year);

                } catch (e) {
                    console.error(e);
                    showToast("Errore durante la lettura del PDF.", "error");
                }

                return; // Esce dalla funzione originale
            }
            // ==========================================

            const existsIndex = payslips.findIndex(p => p.workerId === workerId && p.month === month && p.year === year);

            const publishAction = () => {
                if (existsIndex !== -1) {
                    deleteFileFromDB("payslip_" + payslips[existsIndex].id);
                    payslips.splice(existsIndex, 1);
                }

                const payslipId = "P" + String(payslips.length + 1).padStart(2, '0');

                const newPayslip = {
                    id: payslipId,
                    workerId: workerId,
                    month: month,
                    year: year,
                    netAmount: netAmountVal.toFixed(2),
                    uploadedAt: new Date().toISOString(),
                    status: "Inviata",
                    signedAt: null,
                    baseSalary: netAmountVal.toFixed(2),
                    overtime: "0.00",
                    deductions: "0.00",
                    hasFile: true,
                    fileName: file.name
                };

                saveFileToDB("payslip_" + payslipId, file, function () {
                    payslips.push(newPayslip);
                    localStorage.setItem('vicla_payslips', JSON.stringify(payslips));

                    showToast(`Busta paga pubblicata con successo in formato PDF!`, "success");

                    document.getElementById('form-payslip').reset();
                    document.getElementById('payslip-file-zone-text').innerHTML = `
                        <i class="fa-solid fa-file-pdf text-3xl text-slate-400"></i>
                        <p class="text-xs text-slate-500 font-semibold">Trascina o seleziona il PDF qui</p>
                        <p class="text-[10px] text-slate-400">Verrà memorizzato in modo sicuro localmente</p>
                    `;

                    renderAdminPayslipsTab();

                    // Trigger Notifica Push PWA al dipendente
                    addNotification({
                        workerId: workerId,
                        title: `Disponibile Busta Paga di ${month} ${year}`,
                        message: `È disponibile il tuo cedolino di ${month} ${year}. Clicca per visualizzarlo e apporre la firma.`,
                        type: "payslip",
                        targetTab: "payslips"
                    });
                });
            };

            if (existsIndex !== -1) {
                showConfirmDialog(
                    "Cedolino Esistente",
                    `Esiste già un cedolino per questo lavoratore per ${month} ${year}. Desideri sovrascriverlo?`,
                    publishAction
                );
            } else {
                publishAction();
            }
        }
    </script>

