    <script>
        // =========================================================================
        // GESTIONE PROFILO AZIENDALE DINAMICO (PASSO 1)
        // =========================================================================
        let currentUploadedCompanyLogo = '';

        function getSavedCompanyProfile() {
            try {
                const raw = localStorage.getItem('bacheca_company_profile');
                return raw ? JSON.parse(raw) : null;
            } catch(e) {
                return null;
            }
        }

        function openCompanyRegistrationModal() {
            const modal = document.getElementById('companyRegistrationModal');
            if (!modal) return;

            const profile = getSavedCompanyProfile();
            if (profile) {
                document.getElementById('reg-company-name').value = profile.name || '';
                document.getElementById('reg-company-brand').value = profile.brand || '';
                document.getElementById('reg-company-piva').value = profile.piva || '';
                document.getElementById('reg-company-cf').value = profile.cf || '';
                document.getElementById('reg-company-phone').value = profile.phone || '';
                document.getElementById('reg-company-legal-address').value = profile.legalAddress || '';
                document.getElementById('reg-company-op-address').value = profile.opAddress || '';
                document.getElementById('reg-company-email').value = profile.email || '';

                if (profile.logoBase64) {
                    currentUploadedCompanyLogo = profile.logoBase64;
                    displayCompanyLogoPreview(profile.logoBase64);
                } else {
                    clearCompanyLogoPreview();
                }
            }

            modal.classList.remove('hidden');
        }

        function closeCompanyRegistrationModal() {
            const modal = document.getElementById('companyRegistrationModal');
            if (modal) modal.classList.add('hidden');
        }

        function handleCompanyLogoSelected(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;

            if (file.size > 2 * 1024 * 1024) {
                alert("L'immagine scelta supera i 2MB. Seleziona un file più leggero.");
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                currentUploadedCompanyLogo = e.target.result;
                displayCompanyLogoPreview(currentUploadedCompanyLogo);
            };
            reader.readAsDataURL(file);
        }

        function displayCompanyLogoPreview(base64) {
            const img = document.getElementById('companyLogoPreviewImg');
            const placeholder = document.getElementById('companyLogoPlaceholderContent');
            const btnRemove = document.getElementById('btnRemoveLogo');
            if (img && placeholder) {
                img.src = base64;
                img.classList.remove('hidden');
                placeholder.classList.add('hidden');
            }
            if (btnRemove) btnRemove.classList.remove('hidden');
        }

        function clearCompanyLogoPreview() {
            currentUploadedCompanyLogo = '';
            const img = document.getElementById('companyLogoPreviewImg');
            const placeholder = document.getElementById('companyLogoPlaceholderContent');
            const btnRemove = document.getElementById('btnRemoveLogo');
            const fileInput = document.getElementById('companyLogoFileInput');
            if (img && placeholder) {
                img.src = '';
                img.classList.add('hidden');
                placeholder.classList.remove('hidden');
            }
            if (btnRemove) btnRemove.classList.add('hidden');
            if (fileInput) fileInput.value = '';
        }

        function removeCompanyLogo() {
            clearCompanyLogoPreview();
        }

        function saveCompanyRegistrationData() {
            const name = (document.getElementById('reg-company-name').value || '').trim();

            if (!name) {
                alert("Inserisci almeno la Ragione Sociale dell'Azienda per salvare!");
                return;
            }

            const profile = {
                name: name,
                brand: (document.getElementById('reg-company-brand').value || '').trim(),
                piva: (document.getElementById('reg-company-piva').value || '').trim(),
                cf: (document.getElementById('reg-company-cf').value || '').trim(),
                phone: (document.getElementById('reg-company-phone').value || '').trim(),
                legalAddress: (document.getElementById('reg-company-legal-address').value || '').trim(),
                opAddress: (document.getElementById('reg-company-op-address').value || '').trim(),
                email: (document.getElementById('reg-company-email').value || '').trim(),
                logoBase64: currentUploadedCompanyLogo || '',
                savedAt: new Date().toISOString()
            };

            localStorage.setItem('bacheca_company_profile', JSON.stringify(profile));
            applyCompanyProfileToHeader(profile);
            closeCompanyRegistrationModal();

            if (typeof showToast === 'function') {
                showToast("Dati aziendali salvati con successo!", "success");
            } else {
                alert("Dati aziendali salvati con successo!");
            }
        }

        function applyCompanyProfileToFooter(profile) {
            if (!profile) return;
            const nameEl = document.getElementById('footer-company-name');
            if (nameEl && profile.name) nameEl.textContent = profile.name;

            const addrEl = document.getElementById('footer-company-address');
            if (addrEl && (profile.legalAddress || profile.opAddress)) {
                let parts = [];
                if (profile.legalAddress) parts.push('Sede Legale: ' + profile.legalAddress);
                if (profile.opAddress) parts.push('Sede Operativa: ' + profile.opAddress);
                addrEl.innerHTML = escapeHtml(parts.join(' • '));
            }

            const phoneEl = document.getElementById('footer-company-phone');
            if (phoneEl && profile.phone) {
                phoneEl.href = 'tel:' + profile.phone.replace(/\s+/g, '');
                phoneEl.textContent = profile.phone;
            }

            const emailEl = document.getElementById('footer-company-email');
            if (emailEl && profile.email) {
                emailEl.href = 'mailto:' + profile.email;
                emailEl.textContent = profile.email;
            }
        }

        function applyCompanyProfileToHeader(profile) {
            applyCompanyProfileToFooter(profile);
            if (!profile) return;

            // Aggiorna logo se presente
            const logoEl = document.getElementById('main-company-logo');
            if (logoEl && profile.logoBase64) {
                logoEl.src = profile.logoBase64;
            }

            // Aggiorna nome azienda nell'header
            const titleEl = document.getElementById('main-company-name-display');
            if (titleEl) {
                const displayName = profile.brand || profile.name;
                if (displayName) {
                    titleEl.textContent = displayName;
                }
            }

            // Aggiorna il titolo della scheda del browser
            if (profile.name) {
                document.title = profile.name + " - Portale Aziendale";
            }
        }

        // All'avvio dell'applicazione
        window.addEventListener('DOMContentLoaded', () => {
            const profile = getSavedCompanyProfile();
            if (profile) {
                // Già configurata: applica logo e nome
                applyCompanyProfileToHeader(profile);
            } else {
                // Primo avvio in assoluto: mostra la finestra per configurare l'azienda
                openCompanyRegistrationModal();
            }
        });
    </script>


    <script>
        // =========================================================================
        // GC-SPLASH: ANIMAZIONE FLUIDA A 60 FPS (0 -> 100% SENZA SCATTI - GC CODELAB)
        // =========================================================================
        (function initGcSplash() {
            const bar = document.getElementById('gc-splash-progress-bar');
            const txt = document.getElementById('gc-splash-status-text');
            const pct = document.getElementById('gc-splash-percentage');
            const splash = document.getElementById('gc-splash-screen');

            if (!splash || !bar) return;

            // Rimuovi transition CSS per consentire a requestAnimationFrame di aggiornare a 60 FPS senza lag
            bar.style.transition = 'none';
            bar.style.willChange = 'width';

            const duration = 1600; // 1.6 secondi di caricamento continuo, fluido e naturale
            const startTime = performance.now();

            // Curva di decelerazione morbida e naturale (easeOutQuart)
            function easeOutQuart(x) {
                return 1 - Math.pow(1 - x, 4);
            }

            function updateProgress(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                
                // Calcolo percentuale fluida
                const easedProgress = easeOutQuart(progress);
                const currentPercent = Math.min(Math.round(easedProgress * 100), 100);

                if (bar) bar.style.width = (easedProgress * 100).toFixed(1) + '%';
                if (pct) pct.textContent = currentPercent + '%';

                if (txt) {
                    if (currentPercent < 25) {
                        txt.textContent = 'Inizializzazione sistema...';
                    } else if (currentPercent < 55) {
                        txt.textContent = 'Caricamento moduli e bacheca...';
                    } else if (currentPercent < 80) {
                        txt.textContent = 'Sincronizzazione archivio dati...';
                    } else if (currentPercent < 98) {
                        txt.textContent = 'Verifica autorizzazioni...';
                    } else {
                        txt.textContent = 'Accesso completato!';
                    }
                }

                if (progress < 1) {
                    requestAnimationFrame(updateProgress);
                } else {
                    // Completamento al 100%: breve pausa prima della dissolvenza elegante
                    setTimeout(() => {
                        if (splash) {
                            splash.style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
                            splash.classList.add('opacity-0', 'pointer-events-none');
                            setTimeout(() => {
                                splash.remove();
                            }, 650);
                        }
                    }, 250);
                }
            }

            requestAnimationFrame(updateProgress);
        })();
    </script>

