    <script>
        const dbName = "ViClaFutureFileDB";
        let db;

        function initIndexedDB(callback) {
            const request = indexedDB.open(dbName, 1);
            request.onupgradeneeded = function (e) {
                const activeDb = e.target.result;
                if (!activeDb.objectStoreNames.contains('files')) {
                    activeDb.createObjectStore('files');
                }
            };
            request.onsuccess = function (e) {
                db = e.target.result;
                if (callback) callback();
            };
            request.onerror = function () {
                console.error("Errore nell'inizializzazione del database dei file offline.");
            };
        }

        function saveFileToDB(id, fileBlob, callback) {
            if (!db) return;
            const transaction = db.transaction(['files'], 'readwrite');
            const store = transaction.objectStore('files');
            const request = store.put(fileBlob, id);
            request.onsuccess = function () {
                if (callback) callback();
            };
        }

        function getFileFromDB(id, callback) {
            if (!db) {
                callback(null);
                return;
            }
            const transaction = db.transaction(['files'], 'readonly');
            const store = transaction.objectStore('files');
            const request = store.get(id);
            request.onsuccess = function (e) {
                callback(e.target.result);
            };
            request.onerror = function () {
                callback(null);
            };
        }

        function deleteFileFromDB(id) {
            if (!db) return;
            const transaction = db.transaction(['files'], 'readwrite');
            const store = transaction.objectStore('files');
            store.delete(id);
        }

        initIndexedDB();
    </script>

    <script>
        // Gestione feedback visivi Toast
        function showToast(message, type = "success") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            if (!toast || !toastMsg) return;
            toastMsg.innerText = message;

            if (type === "error") {
                toast.className = "fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-rose-600 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3";
            } else if (type === "warning") {
                toast.className = "fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-amber-500 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3";
            } else if (type === "info") {
                toast.className = "fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-blue-900 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3";
            } else {
                toast.className = "fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-emerald-600 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        function toggleLeaveTypeFields(type) {
            const singleContainer = document.getElementById('single-date-container');
            const multiContainer = document.getElementById('multi-date-container');
            const fromHourContainer = document.getElementById('from-hour-container');
            const toHourContainer = document.getElementById('to-hour-container');
            const hoursTitle = document.getElementById('lbl-hours-title');
            const hoursInput = document.getElementById('leave-hours-num');

            if (type === 'Ferie') {
                singleContainer.classList.add('hidden');
                multiContainer.classList.remove('hidden');
                fromHourContainer.classList.add('hidden');
                toHourContainer.classList.add('hidden');
                hoursTitle.innerText = "N° Ore Totali *";

                // Impostiamo requisiti
                document.getElementById('leave-date').required = false;
                document.getElementById('leave-date-start').required = true;
                document.getElementById('leave-date-end').required = true;
                document.getElementById('leave-from-hour').required = false;
                document.getElementById('leave-to-hour').required = false;

                calculateFerieHours();
            } else {
                singleContainer.classList.remove('hidden');
                multiContainer.classList.add('hidden');
                fromHourContainer.classList.remove('hidden');
                toHourContainer.classList.remove('hidden');
                hoursTitle.innerText = "N° Ore *";
                hoursInput.value = "8"; // Default ore di permesso a 8

                // Impostiamo requisiti
                document.getElementById('leave-date').required = true;
                document.getElementById('leave-date-start').required = false;
                document.getElementById('leave-date-end').required = false;
                document.getElementById('leave-from-hour').required = true;
                document.getElementById('leave-to-hour').required = true;

                calculatePermessoHours();
            }
        }

        function calculatePermessoHours() {
            const fromVal = document.getElementById('leave-from-hour').value;
            const toVal = document.getElementById('leave-to-hour').value;
            const hoursInput = document.getElementById('leave-hours-num');

            if (!fromVal || !toVal) return;

            const [fromH, fromM] = fromVal.split(':').map(Number);
            const [toH, toM] = toVal.split(':').map(Number);

            let diffMinutes = (toH * 60 + toM) - (fromH * 60 + fromM);
            if (diffMinutes < 0) {
                diffMinutes = 0;
            }

            const diffHours = diffMinutes / 60;
            hoursInput.value = parseFloat(diffHours.toFixed(2));
            checkRemainingBalanceCap();
        }

        function calculateFerieHours() {
            const startVal = document.getElementById('leave-date-start').value;
            const endVal = document.getElementById('leave-date-end').value;
            const hoursInput = document.getElementById('leave-hours-num');

            if (!startVal || !endVal) {
                hoursInput.value = "8";
                checkRemainingBalanceCap();
                return;
            }

            const startDate = new Date(startVal);
            const endDate = new Date(endVal);

            if (endDate < startDate) {
                hoursInput.value = "0";
                checkRemainingBalanceCap();
                return;
            }

            let daysCount = 0;
            let curDate = new Date(startDate.getTime());
            while (curDate <= endDate) {
                daysCount++;
                curDate.setDate(curDate.getDate() + 1);
            }

            if (daysCount === 0) daysCount = 1;
            hoursInput.value = daysCount * 8;
            checkRemainingBalanceCap();
        }

        // CONTROLLO DI CAPIENZA SALDO IN TEMPO REALE (NOVITÀ v2.2.1)
        function checkRemainingBalanceCap() {
            const currentWorker = workers.find(w => w.id === selectedWorkerId);
            if (!currentWorker) return;

            const leaveType = document.getElementById('leave-type').value;
            const hoursRequested = parseFloat(document.getElementById('leave-hours-num').value) || 0;
            const warningBox = document.getElementById('leave-capacity-warning');

            let currentBalance = 0;
            if (leaveType === 'Ferie') {
                currentBalance = currentWorker.ferieResidue || 0;
            } else if (leaveType === 'Permesso') {
                currentBalance = currentWorker.permessiResidui || 0;
            } else {
                currentBalance = currentWorker.altreResidue || 0;
            }

            if (hoursRequested > currentBalance) {
                warningBox.classList.remove('hidden');
            } else {
                warningBox.classList.add('hidden');
            }
        }

