            localStorage.setItem('vicla_notifications', JSON.stringify(notifications));
            renderNotificationsDrawer();
            showToast("Tutte le notifiche sono state segnate come lette", "info");
        }

        // 👤 FUNZIONE SOLLECITO FIRME CON 1 CLIC (HR MANAGER)
        function sendBulkSignatureReminders() {
            const pendingWorkerIds = new Set();

            notices.forEach(n => {
                workers.forEach(w => {
                    const hasRead = n.reads && n.reads[w.id];
                    if (!hasRead) {
                        pendingWorkerIds.add(w.id);
                    }
                });
            });

            payslips.forEach(p => {
                if (p.status !== 'Firmata') {
                    pendingWorkerIds.add(p.workerId);
                }
            });

            const recipientCount = pendingWorkerIds.size;
            if (recipientCount === 0) {
                showToast("Tutti i documenti risultano già firmati al 100%! Nessun sollecito necessario.", "success");
                return;
            }

            const now = new Date().toISOString();
            pendingWorkerIds.forEach(workerId => {
                const notif = {
                    id: "REMIND_" + Date.now() + "_" + Math.floor(Math.random() * 1000),
                    workerId: workerId,
                    title: "⚠️ Sollecito Firme in Sospeso",
                    message: "Gentile collaboratore, hai documenti aziendali o cedolini in attesa di firma digitale. Si prega di verificare e completare le firme.",
                    type: "system",
                    targetTab: "notices",
                    date: now,
                    read: false
                };
                notifications.unshift(notif);
            });

            // Notifica di riepilogo per il Responsabile
            notifications.unshift({
                id: "REMIND_CONFIRM_" + Date.now(),
                workerId: "ADMIN",
                title: "Sollecito Firme Inviato",
                message: `Inviato promemoria immediato a ${recipientCount} lavoratori con firme in sospeso.`,
                type: "system",
                targetTab: "notices",
                date: now,
                read: false
            });

            if (notifications.length > 60) notifications = notifications.slice(0, 60);
            localStorage.setItem('vicla_notifications', JSON.stringify(notifications));

            dispatchBrowserPushNotification("⚠️ Sollecito Firme Vi.Cla.", `Inviato promemoria per completamento firme a ${recipientCount} collaboratori.`);
            renderNotificationsDrawer();
            renderAdminDashboard();

            showToast(`🔔 Sollecito istantaneo inviato a ${recipientCount} dipendenti con firme in sospeso!`, "success");
        }

        // Sollecito singolo per una comunicazione
        function sollecitaMancanti() {
            if (!currentSelectedNoticeId) {
                showToast("Seleziona prima una comunicazione!", "warning");
                return;
