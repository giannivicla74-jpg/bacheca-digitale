        function renderAdminPayslipsTab() {
            const tableBody = document.getElementById('admin-payslips-table');
            if (!tableBody) return;
            tableBody.innerHTML = '';

            if (payslips.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="px-4 py-8 text-center text-slate-400">
                            <i class="fa-solid fa-file-invoice-dollar text-2xl mb-1 block"></i>
