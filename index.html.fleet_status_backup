            renderWorkerNotices();
        }

        function renderWorkerNotices() {
            const container = document.getElementById('worker-notices-container');
            if (!container) return;
            container.innerHTML = '';

            const currentWorker = workers.find(w => w.id === selectedWorkerId);
            if (!currentWorker) return;

            const relevantNotices = notices.filter(n => n.department === 'Tutti' || n.department === currentWorker.department);

            const unreadCount = relevantNotices.filter(n => !n.reads[currentWorker.id]).length;
            document.getElementById('worker-unread-badge').innerText = unreadCount;

            let noticesToDisplay = relevantNotices;
            if (workerFilter === 'unread') {
                noticesToDisplay = relevantNotices.filter(n => !n.reads[currentWorker.id]);
            }

            noticesToDisplay.sort((a, b) => {
                const prioWeight = { "Urgente": 4, "Alta": 3, "Media": 2, "Bassa": 1 };
                return (prioWeight[b.priority] || 0) - (prioWeight[a.priority] || 0);
            });

            if (noticesToDisplay.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10 bg-white rounded-2xl border border-slate-200">
                        <i class="fa-solid fa-clipboard-check text-slate-300 text-4xl mb-2"></i>
                        <p class="text-slate-400 text-sm font-semibold">Nessun comunicato da visualizzare.</p>
                    </div>
                `;
                return;
            }

            noticesToDisplay.forEach(notice => {
                const hasRead = !!notice.reads[currentWorker.id];
                const readDate = hasRead ? new Date(notice.reads[currentWorker.id]).toLocaleString('it-IT') : '';

                let cardBorder = "border-slate-200 bg-white";
                let priorityBadge = "bg-slate-100 text-slate-600";

                if (!hasRead) {
                    if (notice.priority === 'Urgente') {
                        cardBorder = "border-l-4 border-l-rose-500 border-slate-200 bg-white shadow-sm ring-1 ring-rose-100";
                        priorityBadge = "bg-rose-100 text-rose-800 animate-pulse";
                    } else if (notice.priority === 'Alta') {
                        cardBorder = "border-l-4 border-l-amber-500 border-slate-200 bg-white shadow-sm";
                        priorityBadge = "bg-amber-100 text-amber-800";
                    }
                }

                const buttonStyle = currentRole === 'operaio' ? 'from-orange-500 to-amber-600' : 'from-teal-600 to-emerald-700';

                const itemHtml = `
                    <div class="p-5 rounded-2xl shadow-sm border ${cardBorder} space-y-3 transition-all bg-white">
                        <div class="flex justify-between items-start">
                            <span class="px-2.5 py-0.5 text-[10px] font-extrabold rounded-md ${priorityBadge}">${escapeHtml(notice.priority)}</span>
                            <span class="text-[10px] text-slate-400 font-medium"><i class="fa-solid fa-clock mr-1"></i>${new Date(notice.date).toLocaleDateString('it-IT')}</span>
                        </div>
                        
                        <div>
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">${escapeHtml(notice.category)}</span>
                            <h5 class="text-base font-extrabold text-slate-800">${escapeHtml(notice.title)}</h5>
                        </div>

                        <p class="text-xs text-slate-600 leading-relaxed bg-slate-50 p-3 rounded-xl border border-slate-100 whitespace-pre-line">${escapeHtml(notice.content)}</p>

                        ${notice.hasAttachment ? `
                            <div class="p-2.5 bg-rose-50/50 rounded-xl border border-rose-100 flex justify-between items-center text-xs">
                                <span class="font-bold text-slate-700 flex items-center gap-1.5 truncate max-w-[200px]">
                                    <i class="fa-solid fa-file-pdf text-rose-500 text-base"></i>
                                    ${escapeHtml(notice.attachmentName)}
                                </span>
                                <button onclick="openNoticeAttachmentForWorker('${escapeHtml(notice.id)}')" class="px-3 py-1 bg-rose-600 text-white font-bold rounded-lg hover:bg-rose-700 transition-all">
                                    Apri Allegato
                                </button>
                            </div>
                        ` : ''}

                        <div class="pt-2 border-t border-slate-100 flex justify-between items-center">
                            ${hasRead ? `
                                <div class="text-xs text-emerald-600 font-extrabold flex items-center gap-1">
                                    <i class="fa-solid fa-circle-check text-base"></i> Letto il ${escapeHtml(readDate)}
                                </div>
                            ` : `
                                <div class="text-xs text-amber-600 font-extrabold flex items-center gap-1">
