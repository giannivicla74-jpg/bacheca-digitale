        // ==========================================
        // CENTRO NOTIFICHE PWA & MOTORE PUSH (v2.5.0)
        // ==========================================

        function isNotificationForCurrentUser(notif) {
            if (!notif) return false;
            if (notif.workerId === 'ALL') return true;
            const role = (typeof window !== 'undefined' && window.currentRole) ? window.currentRole : (typeof currentRole !== 'undefined' ? currentRole : 'admin');
            if (role === 'admin') {
                return notif.workerId === 'ADMIN';
            } else {
                const workerId = (typeof window !== 'undefined' && window.selectedWorkerId) ? window.selectedWorkerId : (typeof selectedWorkerId !== 'undefined' ? selectedWorkerId : null);
                return !!(workerId && notif.workerId === workerId);
            }
        }
        if (typeof window !== 'undefined') window.isNotificationForCurrentUser = isNotificationForCurrentUser;

        function addNotification({ workerId, title, message, type = "system", targetTab = "notices" }) {
            const notif = {
                id: "NOTIF_" + Date.now() + "_" + Math.floor(Math.random() * 1000),
                workerId: workerId, // "W01", "ALL", "ADMIN"
                title: title,
                message: message,
                type: type, // "payslip" | "notice" | "leave" | "system"
                targetTab: targetTab,
                date: new Date().toISOString(),
                read: false
            };

            notifications.unshift(notif);
            if (notifications.length > 60) notifications = notifications.slice(0, 60);

            localStorage.setItem('vicla_notifications', JSON.stringify(notifications));
            
            // Invia notifica push browser SOLO se il destinatario è l'utente attivo su questo dispositivo
            if (isNotificationForCurrentUser(notif)) {
                dispatchBrowserPushNotification(title, message, targetTab);
            }

            renderNotificationsDrawer();
            return notif;
        }
        if (typeof window !== 'undefined') window.addNotification = addNotification;

        function dispatchBrowserPushNotification(title, body, targetTab = "notices") {
            if (!("Notification" in window)) return;

            if (Notification.permission === "granted") {
                const options = {
                    body: body,
                    icon: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48" fill="%231e3a8a"/><text x="50" y="65" font-size="45" font-weight="bold" fill="white" text-anchor="middle">V</text></svg>',
                    badge: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48" fill="%231e3a8a"/><text x="50" y="65" font-size="45" font-weight="bold" fill="white" text-anchor="middle">V</text></svg>',
                    vibrate: [200, 100, 200],
                    data: {
                        url: window.location.href,
                        targetTab: targetTab
                    }
                };

                if (navigator.serviceWorker && navigator.serviceWorker.ready) {
                    navigator.serviceWorker.ready.then(reg => {
                        reg.showNotification(title, options).catch(() => {
                            new Notification(title, options);
                        });
                    }).catch(() => {
                        new Notification(title, options);
                    });
                } else {
                    new Notification(title, options);
                }
            }
        }

        async function enablePushNotifications() {
            if (!("Notification" in window)) {
                showToast("Le notifiche push non sono supportate da questo browser.", "warning");
                return;
            }

            try {
                const permission = await Notification.requestPermission();
                if (permission === "granted") {
                    updatePushBtnState();
                    if (typeof window.syncDevicePushSubscription === 'function') {
                        window.syncDevicePushSubscription(currentRole, selectedWorkerId);
                    }
                    showToast("🔔 Notifiche Push PWA abilitate con successo!", "success");
                    dispatchBrowserPushNotification("🔔 Bacheca Digitale Vi.Cla.", "Notifiche push attivate! Riceverai avvisi anche ad app chiusa.");
                } else if (permission === "denied") {
                    updatePushBtnState();
                    showToast("Notifiche rifiutate. Puoi abilitarle dalle impostazioni del browser.", "warning");
                }
            } catch (err) {
                console.warn("Errore richiesta notifiche:", err);
            }
        }

        function updatePushBtnState() {
            const btn = document.getElementById('btn-request-push');
            if (!btn) return;
            if (!("Notification" in window)) {
                btn.innerText = "Non supportate";
                btn.disabled = true;
                btn.className = "px-2.5 py-1 bg-slate-300 dark:bg-slate-700 text-slate-500 rounded-lg font-bold text-[10px]";
                return;
            }

            if (Notification.permission === "granted") {
                btn.innerHTML = '<i class="fa-solid fa-check mr-1"></i> Attive';
                btn.disabled = true;
                btn.className = "px-2.5 py-1 bg-emerald-600/90 text-white rounded-lg font-bold text-[10px] shadow-xs";
            } else if (Notification.permission === "denied") {
                btn.innerHTML = '<i class="fa-solid fa-ban mr-1"></i> Bloccate';
                btn.disabled = true;
                btn.className = "px-2.5 py-1 bg-rose-600/80 text-white rounded-lg font-bold text-[10px]";
            } else {
                btn.innerHTML = 'Attiva';
                btn.disabled = false;
                btn.className = "px-2.5 py-1 bg-blue-900 hover:bg-blue-950 text-white rounded-lg font-bold text-[10px] transition-all shadow-xs cursor-pointer";
            }
        }

        function testPushToManagers() {
