        function updatePayslipFileLabel() {
            const input = document.getElementById('payslip-pdf-input');
            const textZone = document.getElementById('payslip-file-zone-text');
            if (input.files.length > 0) {
                textZone.innerHTML = `
                    <i class="fa-solid fa-file-pdf text-3xl text-emerald-600"></i>
