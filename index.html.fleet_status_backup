        /* 🃏 GC-CARDS: CARD ANIMATE 3D & HOVER EFFECTS GC CODELAB                    */
        /* ========================================================================= */
        .gc-card-3d {
            position: relative;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.55) 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 1.25rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.1);
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                        box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                        border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                        background 0.35s ease;
            transform: perspective(1000px) translateY(0) translateZ(0);
            will-change: transform, box-shadow;
            overflow: hidden;
        }

        /* Riflesso luce superiore dinamico (ambient glare) */
        .gc-card-3d::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
            opacity: 0.6;
            transition: opacity 0.35s ease;
            pointer-events: none;
        }

        /* Elevazione fluttuante 3D al passaggio del mouse (-translate-y-2) & ombra profonda HD */
        .gc-card-3d:hover {
            transform: perspective(1000px) translateY(-8px) scale(1.02);
        }
        .gc-card-3d:hover::before {
            opacity: 1;
        }

